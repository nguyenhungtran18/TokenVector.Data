# ==============================================================================
# TOKENVECTOR LANGUAGE - NATIVE TABULAR & DATAFRAME ENGINE MODULE
# File: tv_data.tkv (tv.data / tokenvector.data)
# ==============================================================================

import tv

# ------------------------------------------------------------------------------
# 1. Core IO & Factory Functions
# ------------------------------------------------------------------------------

def read_csv(file_path: str, delimiter: str = ",", has_header: bool = True, null_value: str = ""):
    """
    Reads a CSV file into a high-performance native TokenVector DataFrame.
    """
    return tv.internal.data_read_csv(file_path, delimiter, has_header, null_value)

def read_json(file_path: str):
    """
    Reads an NDJSON / JSON Lines or JSON tabular file into a DataFrame.
    """
    return tv.internal.data_read_json(file_path)

def read_feather(file_path: str):
    """
    Reads an Apache Arrow IPC Feather streaming binary file into a DataFrame.
    """
    return tv.internal.data_read_feather(file_path)

def from_dict(data_dict: dict):
    """
    Constructs a DataFrame from a dictionary of column names to lists/arrays.
    """
    return DataFrame(data_dict)

def concat(dfs: list, axis: int = 0):
    """
    Concatenates multiple DataFrames vertically (axis=0) or horizontally (axis=1).
    """
    if axis == 0:
        return tv.internal.data_concat_vertical(dfs)
    elif axis == 1:
        return tv.internal.data_concat_horizontal(dfs)
    else:
        raise ValueError("Axis must be 0 (vertical) or 1 (horizontal).")

# ------------------------------------------------------------------------------
# 2. Aggregation Expression Helpers
# ------------------------------------------------------------------------------

class Agg:
    @staticmethod
    def sum(column: str, out_name: str = None):
        return ("sum", column, out_name)

    @staticmethod
    def mean(column: str, out_name: str = None):
        return ("mean", column, out_name)

    @staticmethod
    def min(column: str, out_name: str = None):
        return ("min", column, out_name)

    @staticmethod
    def max(column: str, out_name: str = None):
        return ("max", column, out_name)

    @staticmethod
    def count(column: str, out_name: str = None):
        return ("count", column, out_name)

    @staticmethod
    def std(column: str, out_name: str = None):
        return ("std", column, out_name)

# ------------------------------------------------------------------------------
# 3. Native Series Class
# ------------------------------------------------------------------------------

class Series:
    def __init__(self, name: str, data: list):
        self._name = name
        self._native_series = tv.internal.create_series(name, data)

    @property
    def name(self) -> str:
        return self._name

    @property
    def length(self) -> int:
        return self._native_series.Length

    @property
    def null_count(self) -> int:
        return self._native_series.NullCount

    def sum(self) -> float:
        return self._native_series.Sum()

    def mean(self) -> float:
        return self._native_series.Mean()

    def min(self) -> float:
        return self._native_series.Min()

    def max(self) -> float:
        return self._native_series.Max()

    def std(self, ddof: int = 1) -> float:
        return self._native_series.Std(ddof)

    def rolling_mean(self, window: int):
        return self._native_series.RollingMean(window)

    def rolling_sum(self, window: int):
        return self._native_series.RollingSum(window)

    def shift(self, periods: int):
        return self._native_series.Shift(periods)

    def diff(self, periods: int = 1):
        return self._native_series.Diff(periods)

    def cumsum(self):
        return self._native_series.CumSum()

    def to_ndarray(self):
        """
        Zero-Copy extraction to tv.NDArray.
        """
        return tv.internal.series_to_ndarray(self._native_series)

    def to_tensor(self, requires_grad: bool = False):
        """
        Converts series directly to an Autograd Tensor.
        """
        return tv.internal.series_to_tensor(self._native_series, requires_grad)

    def __getitem__(self, index: int):
        return self._native_series[index]

    def __len__(self) -> int:
        return self.length

# ------------------------------------------------------------------------------
# 4. Native DataFrame Class
# ------------------------------------------------------------------------------

class DataFrame:
    def __init__(self, data=None):
        if data is None:
            self._native_df = tv.internal.create_empty_dataframe()
        else:
            self._native_df = tv.internal.create_dataframe_from_dict(data)

    @property
    def shape(self) -> tuple:
        return (self._native_df.RowCount, self._native_df.ColumnCount)

    @property
    def row_count(self) -> int:
        return self._native_df.RowCount

    @property
    def column_names(self) -> list:
        return list(self._native_df.ColumnNames)

    def select(self, *columns):
        return self._native_df.Select(list(columns))

    def drop(self, *columns):
        return self._native_df.Drop(list(columns))

    def with_column(self, name: str, series):
        return self._native_df.WithColumn(name, series)

    def filter(self, predicate):
        return self._native_df.Filter(predicate)

    def head(self, n: int = 5):
        return self._native_df.Head(n)

    def tail(self, n: int = 5):
        return self._native_df.Tail(n)

    def sort_by(self, column: str, ascending: bool = True):
        return self._native_df.SortBy(column, ascending)

    def groupby(self, *key_columns):
        return GroupBy(self._native_df, list(key_columns))

    def join(self, other, left_on: str, right_on: str, how: str = "inner"):
        return self._native_df.Join(other._native_df, left_on, right_on, how)

    def asof_join(self, other, left_on: str, right_on: str, by: str = None, tolerance: float = None):
        return self._native_df.AsOfJoin(other._native_df, left_on, right_on, by, tolerance)

    def pivot(self, index: str, columns: str, values: str):
        return self._native_df.Pivot(index, columns, values)

    def melt(self, id_vars: list, value_vars: list, var_name: str = "variable", value_name: str = "value"):
        return self._native_df.Melt(id_vars, value_vars, var_name, value_name)

    def to_csv(self, file_path: str, delimiter: str = ","):
        tv.internal.data_write_csv(self._native_df, file_path, delimiter)

    def to_feather(self, file_path: str):
        tv.internal.data_write_feather(self._native_df, file_path)

    def to_ndarray(self, columns: list = None):
        """
        Zero-Copy extraction to 2D tv.NDArray.
        """
        return tv.internal.df_to_ndarray(self._native_df, columns)

    def to_tensor(self, columns: list = None, requires_grad: bool = False):
        """
        Converts DataFrame numeric columns directly to 2D Autograd Tensor.
        """
        return tv.internal.df_to_tensor(self._native_df, columns, requires_grad)

    def describe(self):
        return self._native_df.Describe()

    def __getitem__(self, key):
        if isinstance(key, str):
            return self._native_df[key]
        return self._native_df[key]

    def __len__(self) -> int:
        return self.row_count

class GroupBy:
    def __init__(self, native_df, key_columns: list):
        self._context = native_df.GroupBy(key_columns)

    def agg(self, *exprs):
        return self._context.Agg(list(exprs))
