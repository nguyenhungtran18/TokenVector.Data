def v1e() -> "i64":
    ta = datetime()
    r = 0
    for rep in range(REP):
        s = _sum_chunk(2500000, 3125000)
        r = r + 1
    tb = datetime()
    return datetime_ticks(tb - ta)

def v1f() -> "i64":
    ta = datetime()
