# -*- coding: utf-8 -*-
# Probe: TKV B1 voi 8 worker (chunk 625k), REP=20, tu do ticks trong worker
N = 5000000
REP = 20

def _sum_chunk(lo: "i64", hi: "i64") -> "f64":
    s = 0.0
    for i in range(lo, hi):
        v = float(i % 10000) * 0.001
        s = s + (v * 2.5 + v)
    return s

def v1a() -> "i64":
    ta = datetime()
    r = 0
    for rep in range(REP):
        s = _sum_chunk(0, 625000)
        r = r + 1
    tb = datetime()
    return datetime_ticks(tb - ta)

def v1b() -> "i64":
    ta = datetime()
    r = 0
    for rep in range(REP):
        s = _sum_chunk(625000, 1250000)
        r = r + 1
    tb = datetime()
    return datetime_ticks(tb - ta)

def v1c() -> "i64":
    ta = datetime()
    r = 0
    for rep in range(REP):
        s = _sum_chunk(1250000, 1875000)
        r = r + 1
    tb = datetime()
    return datetime_ticks(tb - ta)

def v1d() -> "i64":
    ta = datetime()
    r = 0
    for rep in range(REP):
        s = _sum_chunk(1875000, 2500000)
        r = r + 1
    tb = datetime()
    return datetime_ticks(tb - ta)

def v2a() -> "i64":
    ta = datetime()
    c = 0
    for rep in range(REP):
        c = c + _cnt_chunk(0, 625000)
    tb = datetime()
    return datetime_ticks(tb - ta)

