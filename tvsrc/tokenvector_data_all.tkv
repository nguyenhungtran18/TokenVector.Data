# ----------------------------- FilterEngine ----------------------------------
def filter_evaluate_indices(n: "i32", truth: "list[i32]") -> "Mask":
    # Bieu thich FilterEngine.EvaluatePredicate: duyet cac dong va lap mask
    # tu bang truth 0/1 (predicate da duoc danh gia truoc do runner, vi
    # tkvc truyen ham bang lambda tham so - runner build truth truoc).
    if n < 0:
        raise ValueError("rowCount must be non-negative")
    m = make_mask(n, 0)
    for i in range(n):
        if truth[i] == 1:
            m.set(i, 1)
    return m


def filter_and(a: "Mask", b: "Mask") -> "Mask":
    return a.mask_and(b)


def filter_or(a: "Mask", b: "Mask") -> "Mask":
    return a.mask_or(b)


# ----------------------------- Aggregations ----------------------------------
def _col_valid_f64s(c: "Col") -> "list[f64]":
    vals = []
    for i in range(c.length()):
        if c.is_null(i) == 0:
            if c.dtype == DT_I64:
                vals.append(float(c.i64s[i]))
            elif c.dtype == DT_BOOL:
                if c.bools[i] == 1:
                    vals.append(1.0)
                else:
                    vals.append(0.0)
            else:
                vals.append(c.f64s[i])
    return vals


def agg_sum(c: "Col") -> "f64":
    s = 0.0
    for i in range(c.length()):
        if c.is_null(i) == 0:
            if c.dtype == DT_I64:
                s = s + c.i64s[i]
            elif c.dtype == DT_BOOL:
                if c.bools[i] == 1:
                    s = s + 1.0
            else:
                s = s + c.f64s[i]
    return s


def agg_mean(c: "Col") -> "f64":
    n = c.length() - c.null_count()
    if n == 0:
        return float("nan")
    return agg_sum(c) / n


def agg_min(c: "Col") -> "f64":
    vals = _col_valid_f64s(c)
    if len(vals) == 0:
        return float("nan")
    return min(vals)


def agg_max(c: "Col") -> "f64":
    vals = _col_valid_f64s(c)
    if len(vals) == 0:
        return float("nan")
    return max(vals)


def agg_variance(c: "Col", ddof: "i32") -> "f64":
    # Welford 1 pass thay cho 3 pass (agg_mean + valid-list + binh phuong)
    n = c.length()
    vm = c.valid
    vb = vm.bits
    pc = vm.pop_count()
    dt = c.dtype
    cnt = 0
    fcnt = 0.0
    mean = 0.0
    m2 = 0.0
    if dt == DT_I64:
        ib = c.i64s
        if pc == n:
            for i in range(n):
                x = float(ib[i])
                cnt = cnt + 1
                fcnt = fcnt + 1.0
                d = x - mean
                mean = mean + d / fcnt
                m2 = m2 + d * (x - mean)
        else:
            for i in range(n):
                if vb[i] == 1:
                    x = float(ib[i])
                    cnt = cnt + 1
                    fcnt = fcnt + 1.0
                    d = x - mean
                    mean = mean + d / fcnt
                    m2 = m2 + d * (x - mean)
    elif dt == DT_BOOL:
        bb = c.bools
        for i in range(n):
            if vb[i] == 1:
                if bb[i] == 1:
                    x = 1.0
                else:
                    x = 0.0
                cnt = cnt + 1
                fcnt = fcnt + 1.0
                d = x - mean
                mean = mean + d / fcnt
                m2 = m2 + d * (x - mean)
    else:
        fb = c.f64s
        if pc == n:
            for i in range(n):
                x = fb[i]
                cnt = cnt + 1
                fcnt = fcnt + 1.0
                d = x - mean
                mean = mean + d / fcnt
                m2 = m2 + d * (x - mean)
        else:
            for i in range(n):
                if vb[i] == 1:
                    x = fb[i]
                    cnt = cnt + 1
                    fcnt = fcnt + 1.0
                    d = x - mean
                    mean = mean + d / fcnt
                    m2 = m2 + d * (x - mean)
    if cnt <= ddof:
        return float("nan")
    if ddof == 0:
        return m2 / fcnt
    one = 1.0
    denom = fcnt - one
    return m2 / denom


def agg_std(c: "Col", ddof: "i32") -> "f64":
    v = agg_variance(c, ddof)
    if v != v:
        return float("nan")
    return v ** 0.5


def agg_median(c: "Col") -> "f64":
    return agg_quantile(c, 0.5)


def agg_quantile(c: "Col", q: "f64") -> "f64":
    if q < 0.0 or q > 1.0:
        raise ValueError("Quantile q must be between 0.0 and 1.0")
    vals = _col_valid_f64s(c)
    n = len(vals)
    if n == 0:
        return float("nan")
    if n == 1:
        return vals[0]
    svals = sorted(vals)
    pos = q * (n - 1)
    low = int(pos)
    high = int(pos + 0.5)
    if high < low:
        high = low
    frac = pos - low
    if low == high:
        return svals[low]
    return svals[low] * (1.0 - frac) + svals[high] * frac


# ---------------------------- WindowFunctions --------------------------------
def win_rolling_mean(c: "Col", window: "i32", min_periods: "i32") -> "Col":
    if window <= 0:
        raise ValueError("Window size must be > 0")
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    running = 0.0
    valid = 0
    for i in range(n):
        if c.is_null(i) == 0:
            running = running + _col_f64_at(c, i)
            valid = valid + 1
        leaving = i - window
        if leaving >= 0 and c.is_null(leaving) == 0:
            running = running - _col_f64_at(c, leaving)
            valid = valid - 1
        if valid >= min_periods:
            vals.append(running / valid)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def _win_valid_count(c: "Col", upto: "i32", window: "i32") -> "i32":
    start = upto - window + 1
    if start < 0:
        start = 0
    cnt = 0
    for j in range(start, upto + 1):
        if c.is_null(j) == 0:
            cnt = cnt + 1
    return cnt


def _col_f64_at(c: "Col", i: "i32") -> "f64":
    if c.dtype == DT_I64:
        return float(c.i64s[i])
    if c.dtype == DT_BOOL:
        if c.bools[i] == 1:
            return 1.0
        return 0.0
    return c.f64s[i]


def win_rolling_sum(c: "Col", window: "i32", min_periods: "i32") -> "Col":
    if window <= 0:
        raise ValueError("Window size must be > 0")
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    running = 0.0
    valid = 0
    for i in range(n):
        if c.is_null(i) == 0:
            running = running + _col_f64_at(c, i)
            valid = valid + 1
        leaving = i - window
        if leaving >= 0 and c.is_null(leaving) == 0:
            running = running - _col_f64_at(c, leaving)
            valid = valid - 1
        if valid >= min_periods:
            vals.append(running)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_rolling_std(c: "Col", window: "i32", min_periods: "i32") -> "Col":
    if window <= 1:
        raise ValueError("Window size for std must be > 1")
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    s = 0.0
    s2 = 0.0
    cnt = 0
    for i in range(n):
        if c.is_null(i) == 0:
            x = _col_f64_at(c, i)
            s = s + x
            s2 = s2 + x * x
            cnt = cnt + 1
        leaving = i - window
        if leaving >= 0 and c.is_null(leaving) == 0:
            x = _col_f64_at(c, leaving)
            s = s - x
            s2 = s2 - x * x
            cnt = cnt - 1
        if cnt >= min_periods and cnt > 1:
            var = s2 / (cnt - 1) - (s * s) / ((cnt - 1) * cnt)
            if var < 0.0:
                var = 0.0
            vals.append(var ** 0.5)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_shift(c: "Col", periods: "i32") -> "Col":
    n = c.length()
    r = make_col_f64([])
    r.dtype = c.dtype
    if c.dtype == DT_I64:
        r.i64s = []
    elif c.dtype == DT_BOOL:
        r.bools = []
    mk = make_mask(n, 0)
    for i in range(n):
        src = i - periods
        if src >= 0 and src < n and c.is_null(src) == 0:
            if c.dtype == DT_I64:
                r.i64s.append(c.i64s[src])
            elif c.dtype == DT_BOOL:
                r.bools.append(c.bools[src])
            else:
                r.f64s.append(c.f64s[src])
            mk.set(i, 1)
        else:
            if c.dtype == DT_I64:
                r.i64s.append(0)
            elif c.dtype == DT_BOOL:
                r.bools.append(0)
            else:
                r.f64s.append(0.0)
    r.valid = mk
    return r


def win_diff(c: "Col", periods: "i32") -> "Col":
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        prev = i - periods
        if prev >= 0 and c.is_null(i) == 0 and c.is_null(prev) == 0:
            vals.append(_col_f64_at(c, i) - _col_f64_at(c, prev))
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_cumsum(c: "Col") -> "Col":
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    running = 0.0
    for i in range(n):
        if c.is_null(i) == 0:
            running = running + _col_f64_at(c, i)
            vals.append(running)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_rank(c: "Col", ascending: "i32") -> "Col":
    n = c.length()
    vals = []
    idxs = []
    for i in range(n):
        if c.is_null(i) == 0:
            vals.append(_col_f64_at(c, i))
            idxs.append(i)
    pairs = []
    for k in range(len(vals)):
        p = PairItem(vals[k], idxs[k])
        pairs.append(p)
    if ascending == 1:
        sorted_pairs = sort_pairs_asc(pairs)
    else:
        sorted_pairs = sort_pairs_desc(pairs)
    out = []
    for i in range(n):
        out.append(0.0)
    mk = make_mask(n, 0)
    for k in range(len(sorted_pairs)):
        p = sorted_pairs[k]
        out[p.idx] = k + 1.0
        mk.set(p.idx, 1)
    r = make_col_f64(out)
    r.valid = mk
    return r


class PairItem:
    val: "f64"
    idx: "i32"


def sort_pairs_asc(items: "list[PairItem]") -> "list[PairItem]":
    # insertion sort theo val tang dan
    n = len(items)
    arr = []
    for i in range(n):
        arr.append(items[i])
    for i in range(1, n):
        cur = arr[i]
        j = i - 1
        while j >= 0:
            cj = arr[j]
            if cj.val > cur.val:
                arr[j + 1] = arr[j]
                j = j - 1
            else:
                break
        arr[j + 1] = cur
    return arr


def sort_pairs_desc(items: "list[PairItem]") -> "list[PairItem]":
    n = len(items)
    arr = []
    for i in range(n):
        arr.append(items[i])
    for i in range(1, n):
        cur = arr[i]
        j = i - 1
        while j >= 0:
            cj = arr[j]
            if cj.val < cur.val:
                arr[j + 1] = arr[j]
                j = j - 1
            else:
                break
        arr[j + 1] = cur
    return arr

# ================== v1.4: interpolate/where/expanding/ewm ====================
def series_interpolate(s: "Series", method: "str") -> "Series":
    # pandas Series.interpolate(method='linear'|'ffill'|'bfill')
    # linear: noi suy tuyen tinh giua 2 diem valid gan nhat.
    # Null o DAU giu null (pandas default forward); null o CUOI giu null.
    if s.dtype == DT_STR:
        raise ValueError("series_interpolate: chi ho tro cot numeric")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    if method == "ffill":
        last_val = 0.0
        has_last = 0
        for i in range(n):
            if s.is_null(i) == 0:
                last_val = s.get_f64(i)
                has_last = 1
                vals.append(last_val)
                mk.set(i, 1)
            elif has_last == 1:
                vals.append(last_val)
                mk.set(i, 1)
            else:
                vals.append(0.0)
        return make_series_f64_with_mask(s.name, vals, mk)
    if method == "bfill":
        nxt_val = 0.0
        nxt_idx = 0 - 1
        for i in range(n):
            if s.is_null(i) == 0:
                nxt_val = s.get_f64(i)
                nxt_idx = i
                break
        cur = nxt_val
        has_cur = 0
        if nxt_idx >= 0:
            has_cur = 1
        for i in range(n):
            if s.is_null(i) == 0:
                cur = s.get_f64(i)
                has_cur = 1
                vals.append(cur)
                mk.set(i, 1)
            elif has_cur == 1:
                vals.append(cur)
                mk.set(i, 1)
            else:
                vals.append(0.0)
        return make_series_f64_with_mask(s.name, vals, mk)
    if method != "linear":
        raise ValueError("series_interpolate: method phai linear|ffill|bfill")
    # linear: quet theo doan [prev_valid .. next_valid]
    i = 0
    prev_pos = 0 - 1
    prev_val = 0.0
    while i < n:
        if s.is_null(i) == 0:
            vals.append(s.get_f64(i))
            mk.set(i, 1)
            prev_pos = i
            prev_val = s.get_f64(i)
            i = i + 1
            continue
        # doan null: tim next_valid
        j = i
        while j < n:
            if s.is_null(j) == 0:
                break
            j = j + 1
        if prev_pos < 0:
            # null o DAU -> giu null
            for k in range(i, j):
                vals.append(0.0)
        elif j >= n:
            # null o CUOI -> giu null
            for k in range(i, j):
                vals.append(0.0)
        else:
            nv = s.get_f64(j)
            span = j - prev_pos
            # BUG THAT (2026-09-21): t phai duoc khai kieu f64 TU DAU (khoi
            # tao 0.0) - neu de compiler suy dien tu phep chia (k-prev_pos)
            # / span thi bien mang kieu int va ket qua bi ep thanh 0/1
            # (interpolate tra ve gia tri dau mut thay vi noi suy).
            t = 0.0
            for k in range(i, j):
                t = (k - prev_pos) / span
                vals.append(prev_val + (nv - prev_val) * t)
                mk.set(k, 1)
        if j < n:
            vals.append(s.get_f64(j))
            mk.set(j, 1)
            prev_pos = j
            prev_val = s.get_f64(j)
            i = j + 1
        else:
            i = j
    return make_series_f64_with_mask(s.name, vals, mk)


def series_where(s: "Series", cond: "Mask", other: "Series") -> "Series":
    # pandas Series.where(cond, other): giu khi cond=1, thay bang other khi cond=0
    n = s.length()
    if other.length() != n:
        raise ValueError("series_where: other phai cung do dai")
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        keep = cond.get(i)
        if keep == 1 and s.is_null(i) == 0:
            vals.append(s.get_f64(i))
            mk.set(i, 1)
        elif keep == 1:
            vals.append(0.0)
        elif other.is_null(i) == 0:
            vals.append(other.get_f64(i))
            mk.set(i, 1)
        else:
            vals.append(0.0)
    return make_series_f64_with_mask(s.name, vals, mk)


def series_mask(s: "Series", cond: "Mask", other: "Series") -> "Series":
    # pandas Series.mask(cond, other): NGUOC where - thay khi cond=1
    n = s.length()
    if other.length() != n:
        raise ValueError("series_mask: other phai cung do dai")
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        repl = cond.get(i)
        if repl == 0 and s.is_null(i) == 0:
            vals.append(s.get_f64(i))
            mk.set(i, 1)
        elif repl == 0:
            vals.append(0.0)
        elif other.is_null(i) == 0:
            vals.append(other.get_f64(i))
            mk.set(i, 1)
        else:
            vals.append(0.0)
    return make_series_f64_with_mask(s.name, vals, mk)


def win_expanding_sum(c: "Col") -> "Col":
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    run = 0.0
    has_v = 0
    for i in range(n):
        if c.is_null(i) == 0:
            run = run + _col_f64_at(c, i)
            has_v = 1
        if has_v == 1:
            vals.append(run)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_expanding_mean(c: "Col") -> "Col":
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    run = 0.0
    cnt = 0
    for i in range(n):
        if c.is_null(i) == 0:
            run = run + _col_f64_at(c, i)
            cnt = cnt + 1
        if cnt > 0:
            vals.append(run / cnt)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_expanding_min(c: "Col") -> "Col":
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    cur = 0.0
    has_v = 0
    for i in range(n):
        if c.is_null(i) == 0:
            v = _col_f64_at(c, i)
            if has_v == 0:
                cur = v
                has_v = 1
            elif v < cur:
                cur = v
        if has_v == 1:
            vals.append(cur)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_expanding_max(c: "Col") -> "Col":
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    cur = 0.0
    has_v = 0
    for i in range(n):
        if c.is_null(i) == 0:
            v = _col_f64_at(c, i)
            if has_v == 0:
                cur = v
                has_v = 1
            elif v > cur:
                cur = v
        if has_v == 1:
            vals.append(cur)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_expanding_std(c: "Col", ddof: "i32") -> "Col":
    # ddof=1 (pandas default) hoac 0 - Welford 1-pass
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    mean = 0.0
    m2 = 0.0
    cnt = 0
    for i in range(n):
        if c.is_null(i) == 0:
            x = _col_f64_at(c, i)
            cnt = cnt + 1
            d = x - mean
            mean = mean + d / cnt
            m2 = m2 + d * (x - mean)
        if cnt > ddof:
            vals.append((m2 / (cnt - ddof)) ** 0.5)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_ewm_mean(c: "Col", span: "i32", adjust: "i32") -> "Col":
    # pandas ewm(span=s, adjust=bool).mean() - KHOP XAC pandas (da doi chieu
    # python -c pandas tren may that, 2026-09-21):
    #   adjust=1 (True, mac dinh): num_t = (1-a)*num_{t-1} + x_t ;
    #     den_t = (1-a)*den_{t-1} + 1  (trong so MOI nhat = 1, lich su decay).
    #     Null GIUA: bo qua x nhung den VAN decay (pandas ignore_na=False).
    #     Ket qua x=[1,2,3,4], s=3: [1, 1.667, 2.429, 3.267].
    #   adjust=0 (False): de quy y_t = a*x_t + (1-a)*y_{t-1}, a=2/(s+1);
    #     null giua GIU y (pandas khong update). Ket qua: [1, 1.5, 2.25, 3.125].
    if span <= 0:
        raise ValueError("win_ewm_mean: span phai > 0")
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    alpha = 2.0 / (span + 1.0)
    y = 0.0
    num = 0.0
    den = 0.0
    started = 0
    for i in range(n):
        if c.is_null(i) == 0:
            x = _col_f64_at(c, i)
            if started == 0:
                started = 1
                num = x
                den = 1.0
                y = x
            elif adjust == 1:
                num = (1.0 - alpha) * num + x
                den = (1.0 - alpha) * den + 1.0
                y = num / den
            else:
                y = alpha * x + (1.0 - alpha) * y
            vals.append(y)
            mk.set(i, 1)
        else:
            # null: adjust=1 decay den (ignore_na=False); adjust=0 giu y.
            if started == 1 and adjust == 1:
                den = (1.0 - alpha) * den
            if started == 1:
                vals.append(y)
                mk.set(i, 1)
            else:
                vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_pct_change(c: "Col") -> "Col":
    # (x_t - x_{t-1}) / x_{t-1} - null o dau / khi canh co null
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if i == 0 or c.is_null(i) == 1 or c.is_null(i - 1) == 1:
            vals.append(0.0)
            continue
        prev = _col_f64_at(c, i - 1)
        if prev == 0.0:
            vals.append(0.0)
            continue
        vals.append((_col_f64_at(c, i) - prev) / prev)
        mk.set(i, 1)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_cumprod(c: "Col") -> "Col":
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    run = 1.0
    has_v = 0
    for i in range(n):
        if c.is_null(i) == 0:
            run = run * _col_f64_at(c, i)
            has_v = 1
        if has_v == 1:
            vals.append(run)
            mk.set(i, 1)
        else:
            vals.append(1.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_cummax(c: "Col") -> "Col":
    return win_expanding_max(c)


def win_cummin(c: "Col") -> "Col":
    return win_expanding_min(c)


def win_apply(c: "Col", window: "i32", f: "func(list[f64])->f64", min_periods: "i32") -> "Col":
    # pandas rolling(window).apply(f) - f nhan list gia tri VALID cua cua so
    if window <= 0:
        raise ValueError("win_apply: window phai > 0")
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        start = i - window + 1
        if start < 0:
            start = 0
        seg = []
        for j in range(start, i + 1):
            if c.is_null(j) == 0:
                seg.append(_col_f64_at(c, j))
        if len(seg) >= min_periods and len(seg) > 0:
            vals.append(f(seg))
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_rolling_min(c: "Col", window: "i32", min_periods: "i32") -> "Col":
    if window <= 0:
        raise ValueError("Window size must be > 0")
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        start = i - window + 1
        if start < 0:
            start = 0
        cur = 0.0
        cnt = 0
        for j in range(start, i + 1):
            if c.is_null(j) == 0:
                v = _col_f64_at(c, j)
                if cnt == 0:
                    cur = v
                    cnt = 1
                elif v < cur:
                    cur = v
        if cnt >= min_periods and cnt > 0:
            vals.append(cur)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_rolling_max(c: "Col", window: "i32", min_periods: "i32") -> "Col":
    if window <= 0:
        raise ValueError("Window size must be > 0")
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        start = i - window + 1
        if start < 0:
            start = 0
        cur = 0.0
        cnt = 0
        for j in range(start, i + 1):
            if c.is_null(j) == 0:
                v = _col_f64_at(c, j)
                if cnt == 0:
                    cur = v
                    cnt = 1
                elif v > cur:
                    cur = v
        if cnt >= min_periods and cnt > 0:
            vals.append(cur)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_rolling_count(c: "Col", window: "i32") -> "Col":
    # dem so gia tri VALID trong cua so (pandas rolling().count())
    if window <= 0:
        raise ValueError("Window size must be > 0")
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        start = i - window + 1
        if start < 0:
            start = 0
        cnt = 0
        for j in range(start, i + 1):
            if c.is_null(j) == 0:
                cnt = cnt + 1
        vals.append(cnt)
        mk.set(i, 1)
    r = make_col_f64(vals)
    r.valid = mk
    return r


def win_rolling_var(c: "Col", window: "i32", min_periods: "i32", ddof: "i32") -> "Col":
    # Welford sliding (pandas rolling().var(ddof))
    if window <= 0:
        raise ValueError("Window size must be > 0")
    n = c.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        start = i - window + 1
        if start < 0:
            start = 0
        mean = 0.0
        m2 = 0.0
        cnt = 0
        for j in range(start, i + 1):
            if c.is_null(j) == 0:
                x = _col_f64_at(c, j)
                cnt = cnt + 1
                d = x - mean
                mean = mean + d / cnt
                m2 = m2 + d * (x - mean)
        if cnt > ddof:
            vals.append(m2 / (cnt - ddof))
            mk.set(i, 1)
        else:
            vals.append(0.0)
    r = make_col_f64(vals)
    r.valid = mk
    return r

# ================== v1.5: rounding/clip/sign/trunc + isin ====================
def series_floor(s: "Series") -> "Series":
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 0:
            vals.append(s.get_f64(i) // 1.0)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    return make_series_f64_with_mask(s.name, vals, mk)


def series_ceil(s: "Series") -> "Series":
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 0:
            x = s.get_f64(i)
            f = x // 1.0
            if x > f:
                f = f + 1.0
            vals.append(f)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    return make_series_f64_with_mask(s.name, vals, mk)


def series_trunc(s: "Series") -> "Series":
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 0:
            x = s.get_f64(i)
            f = x // 1.0
            if x < 0.0 and x < f:
                f = f + 1.0
            vals.append(f)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    return make_series_f64_with_mask(s.name, vals, mk)


def series_round(s: "Series", digits: "i32") -> "Series":
    # lam tron 1/2 len tren (Python banker's rounding khong lam - pandas cung round-half-even NHUNG thuc te numpy la half-away tu 1.x; chuan nay khop numpy.round da kiem: 2.5->2.0. DUNG numpy: round-half-even)
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    mul = 1.0
    j = 0
    while j < digits:
        mul = mul * 10.0
        j = j + 1
    j2 = 0
    while j2 > digits:
        mul = mul / 10.0
        j2 = j2 - 1
    for i in range(n):
        if s.is_null(i) == 0:
            x = s.get_f64(i) * mul
            fl = x // 1.0
            diff = x - fl
            if diff > 0.5:
                fl = fl + 1.0
            elif diff == 0.5:
                # half-to-even
                m2 = fl // 2.0 * 2.0
                if m2 != fl:
                    fl = fl + 1.0
            vals.append(fl / mul)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    return make_series_f64_with_mask(s.name, vals, mk)


def series_clip(s: "Series", lo: "f64", hi: "f64") -> "Series":
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 0:
            x = s.get_f64(i)
            if x < lo:
                x = lo
            if x > hi:
                x = hi
            vals.append(x)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    return make_series_f64_with_mask(s.name, vals, mk)


def series_sign(s: "Series") -> "Series":
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 0:
            x = s.get_f64(i)
            if x > 0.0:
                vals.append(1.0)
            elif x < 0.0:
                vals.append(0.0 - 1.0)
            else:
                vals.append(0.0)
            mk.set(i, 1)
        else:
            vals.append(0.0)
    return make_series_f64_with_mask(s.name, vals, mk)


def series_isin(s: "Series", values: "list[str]") -> "Mask":
    # pandas Series.isin - so sanh qua chuoi (get_string) nen dung duoc cho
    # moi dtype; values la list gia tri dang chuoi (vd ["1.0", "3.0"]).
    n = s.length()
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 0:
            v = s.get_string(i)
            hit = 0
            for k in range(len(values)):
                if values[k] == v:
                    hit = 1
                    break
            if hit == 1:
                mk.set(i, 1)
    return mk


def df_isna(df: "DataFrame") -> "DataFrame":
    # pandas df.isna(): 1 DF bool cung kich thuoc, True tai o null
    nc = df.column_count()
    out_cols = []
    for c in range(nc):
        sc = df.col_at(c)
        n = sc.length()
        bvals = []
        for i in range(n):
            if sc.is_null(i) == 1:
                bvals.append(1)
            else:
                bvals.append(0)
        out_cols.append(make_series_bool(sc.name, bvals))
    return make_df(out_cols)


def df_dropna_rows_all(df: "DataFrame") -> "DataFrame":
    # pandas dropna(how="all"): bo dong ma TAT CA cot deu null
    nc = df.column_count()
    n = df.row_count()
    keep = make_mask(n, 0)
    for i in range(n):
        all_null = 1
        for c in range(nc):
            if df.col_at(c).is_null(i) == 0:
                all_null = 0
                break
        if all_null == 0:
            keep.set(i, 1)
    idx = keep.to_indices()
    out_cols = []
    for c in range(nc):
        out_cols.append(df.col_at(c).take(idx))
    return make_df(out_cols)

# ================== v1.5B: agg prod/sem/mode ====================
def agg_prod(c: "Col") -> "f64":
    n = c.length()
    prod = 1.0
    has = 0
    for i in range(n):
        if c.is_null(i) == 0:
            prod = prod * c.get_f64(i)
            has = 1
    if has == 0:
        return float("nan")
    return prod


def agg_sem(c: "Col", ddof: "i32") -> "f64":
    # standard error of mean = std / sqrt(n_valid)
    n = c.length()
    vcnt = 0
    fcnt = 0.0
    total = 0.0
    for i in range(n):
        if c.is_null(i) == 0:
            total = total + c.get_f64(i)
            vcnt = vcnt + 1
            fcnt = fcnt + 1.0
    if vcnt == 0:
        return float("nan")
    sd = agg_std(c, ddof)
    return sd / fcnt ** 0.5


def agg_mode(c: "Col") -> "f64":
    # gia tri xuat hien nhieu nhat (f64, null bo qua); hoa -> gia tri gap dau
    n = c.length()
    counts = {}
    best_v = 0.0
    best_c = 0
    for i in range(n):
        if c.is_null(i) == 0:
            x = c.get_f64(i)
            key = str(x)
            if key in counts:
                counts[key] = counts[key] + 1
            else:
                counts[key] = 1
            if counts[key] > best_c:
                best_c = counts[key]
                best_v = x
    if best_c == 0:
        return float("nan")
    return best_v


def _series_col(s: "Series") -> "Col":
    # boc 1 Series thanh Col (Col chi co f64 buffer + valid) - dung cho
    # cac agg thu f64. Co null -> khong qua mask giu nguyen qua valid.
    n = s.length()
    vals = []
    for i in range(n):
        if s.is_null(i) == 0:
            vals.append(s.get_f64(i))
        else:
            vals.append(0.0)
    vm = s.valid
    return make_col_f64_with_mask(vals, vm)


def series_prod(s: "Series") -> "f64":
    return agg_prod(_series_col(s))


def series_sem(s: "Series", ddof: "i32") -> "f64":
    return agg_sem(_series_col(s), ddof)


def series_mode(s: "Series") -> "f64":
    return agg_mode(_series_col(s))

# -*- coding: utf-8 -*-
# =============================================================================
# TokenVector.Data - Module Apply/Transform (nhan ham)
# Mo rong API theo huong pandas: apply/transform/map nhan 1 HAM TKV
# (top-level func, nested func hoac lambda truyen thang - compiler hoat dong
#  dung voi tham so kieu "func(...)->...").
# - series_apply(s, f):        f: func(f64)->f64, cot numeric -> Series f64 moi
# - series_apply_str(s, f):    f: func(str)->str, cot str   -> Series str moi
# - series_filter_fn(s, pred): pred: func(f64)->i32 (0/1), giu row pred!=0
# - series_filter_fn_str(s, pred): pred: func(str)->i32
# - series_reduce(s, f, init): f: func(f64,f64)->f64 fold 2 tham so
# - series_sort_by_key(s, key): key: func(f64)->f64, sort theo gia tri key
# - df_apply_col(df, name, f): thay/tao cot = f(value) (numeric)
# - df_transform(df, name, f): giong df_apply_col (alias ro nghia pandas)
# - df_filter_rows(df, name, pred): giu row ma pred(value) != 0 (numeric)
# - df_filter_rows_str(df, name, pred): nhu tren cho cot str
# Luu y: moi ham LAY 1 GIA TRI duy nhat (null -> khong goi f, giu null).
# =============================================================================
def series_apply(s: "Series", f: "func(f64)->f64") -> "Series":
    if s.dtype == DT_STR:
        raise ValueError("series_apply: cot str dung series_apply_str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        notnull = 1 - s.is_null(i)
        if notnull == 0:
            vals.append(0.0)
        else:
            x = s.get_f64(i)
            vals.append(f(x))
        mk.set(i, notnull)
    return make_series_f64_with_mask(s.name, vals, mk)


def series_apply_str(s: "Series", f: "func(str)->str") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_apply_str: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
        else:
            vals.append(f(s.get_string(i)))
            mk.set(i, 1)
    return make_series_str_with_mask(s.name, vals, mk)


def _filter_idx_fn(s: "Series", pred: "func(f64)->i32") -> "list[i32]":
    n = s.length()
    keep = make_idx([])
    for i in range(n):
        notnull = 1 - s.is_null(i)
        if notnull == 1:
            x = s.get_f64(i)
            pv = pred(x)
            if pv == 1:
                keep.append(i)
    return keep


def series_filter_fn(s: "Series", pred: "func(f64)->i32") -> "Series":
    keep = _filter_idx_fn(s, pred)
    return s.take(keep)


def _filter_idx_fn_str(s: "Series", pred: "func(str)->i32") -> "list[i32]":
    n = s.length()
    keep = make_idx([])
    for i in range(n):
        notnull = 1 - s.is_null(i)
        if notnull == 1:
            pv = pred(s.get_string(i))
            if pv == 1:
                keep.append(i)
    return keep


def series_filter_fn_str(s: "Series", pred: "func(str)->i32") -> "Series":
    keep = _filter_idx_fn_str(s, pred)
    return s.take(keep)


def series_reduce(s: "Series", f: "func(f64,f64)->f64", init: "f64") -> "f64":
    n = s.length()
    acc = init
    for i in range(n):
        notnull = 1 - s.is_null(i)
        if notnull == 1:
            acc = f(acc, s.get_f64(i))
    return acc


def series_sort_by_key(s: "Series", key: "func(f64)->f64", ascending: "i32") -> "Series":
    # Sort gia tri cua Series theo gia tri key(v) (merge sort O(n log n))
    n = s.length()
    items = []
    for i in range(n):
        notnull = 1 - s.is_null(i)
        if notnull == 0:
            items.append(RowKey(0.0, i, 1))
        else:
            items.append(RowKey(key(s.get_f64(i)), i, 0))
    sorted_items = sort_rows(items, ascending)
    idx = make_idx([])
    for i in range(n):
        rk = sorted_items[i]
        idx.append(rk.idx)
    return s.take(idx)


def df_apply_col(df: "DataFrame", name: "str", f: "func(f64)->f64") -> "DataFrame":
    # Tra DF moi voi cot name da qua f (cot khac giu nguyen)
    idx = df.col_index(name)
    cols = []
    nc = df.column_count()
    for i in range(nc):
        c = df.col_at(i)
        if i == idx:
            cols.append(series_apply(c, f))
        else:
            cols.append(c.clone_series())
    return make_df(cols)


def df_transform(df: "DataFrame", name: "str", f: "func(f64)->f64") -> "DataFrame":
    # Alias ro nghia cua pandas transform: ap dung f tren toan bo cot name
    return df_apply_col(df, name, f)


def df_filter_rows(df: "DataFrame", name: "str", pred: "func(f64)->i32") -> "DataFrame":
    c = df.col_by_name(name)
    keep = make_idx([])
    n = c.length()
    for i in range(n):
        if c.is_null(i) == 0 and pred(c.get_f64(i)) != 0:
            keep.append(i)
    cols = []
    nc = df.column_count()
    for j in range(nc):
        cj = df.col_at(j)
        cols.append(cj.take(keep))
    return make_df(cols)


def df_filter_rows_str(df: "DataFrame", name: "str", pred: "func(str)->i32") -> "DataFrame":
    c = df.col_by_name(name)
    keep = make_idx([])
    n = c.length()
    for i in range(n):
        if c.is_null(i) == 0 and pred(c.get_string(i)) != 0:
            keep.append(i)
    cols = []
    nc = df.column_count()
    for j in range(nc):
        cj = df.col_at(j)
        cols.append(cj.take(keep))
    return make_df(cols)


def df_apply_col_str(df: "DataFrame", name: "str", f: "func(str)->str") -> "DataFrame":
    idx = df.col_index(name)
    cols = []
    nc = df.column_count()
    for i in range(nc):
        c = df.col_at(i)
        if i == idx:
            cols.append(series_apply_str(c, f))
        else:
            cols.append(c.clone_series())
    return make_df(cols)

# -*- coding: utf-8 -*-
# =============================================================================
# TokenVector.Data - Module String ops bo sung (v1.2)
# series_str_len / strip / lstrip / rstrip / split / split_get / split_df /
# slice (substring) / find / zfill / pad / repeat
# + Regex API dan tren BUILTIN re_* cua compiler (System.Text.RegularExpressions
#   .NET - full syntax, chay C speed): re_test / re_find / re_find_all /
#   re_count / series_str_extract / series_str_re_test / series_str_replace_re
# Theo idiom pandas .str.* nhung la ham tu do (tkv khong co method namespace).

# ------------------------------ len / trim -----------------------------------
def series_str_len(s: "Series") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_str_len: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
        else:
            vals.append(len(s.get_string(i)))
            mk.set(i, 1)
    return make_series_i64_with_mask("len", vals, mk)


def _str_strip_one_side(t: "str", left: "i32", right: "i32") -> "str":
    a = 0
    b = len(t)
    if left == 1:
        while a < b:
            ch = t[a]
            if ch == " " or ch == "\t" or ch == "\r" or ch == "\n":
                a = a + 1
            else:
                break
    if right == 1:
        while b > a:
            ch = t[b - 1]
            if ch == " " or ch == "\t" or ch == "\r" or ch == "\n":
                b = b - 1
            else:
                break
    if a == 0 and b == len(t):
        return t
    return t[a:b]


def series_str_strip(s: "Series") -> "Series":
    return series_apply_str(s, lambda t: _str_strip_one_side(t, 1, 1))


def series_str_lstrip(s: "Series") -> "Series":
    return series_apply_str(s, lambda t: _str_strip_one_side(t, 1, 0))


def series_str_rstrip(s: "Series") -> "Series":
    return series_apply_str(s, lambda t: _str_strip_one_side(t, 0, 1))


# ------------------------------ split ---------------------------------------
def _str_split_once(t: "str", sep: "str") -> "list[str]":
    # Tach thanh 2 phan [head, tail]; neu khong gap sep -> [t, None]
    if sep == "":
        raise ValueError("split: separator rong")
    idx = t.find(sep)
    if idx < 0:
        parts = []
        parts.append(t)
        parts.append(None)
        return parts
    parts2 = []
    parts2.append(t[0:idx])
    parts2.append(t[idx + len(sep):])
    return parts2


def series_str_split_get(s: "Series", sep: "str", part: "i32") -> "Series":
    # part: 0 = phan dau, 1 = phan sau lan xuat hien dau tien
    if s.dtype != DT_STR:
        raise ValueError("series_str_split_get: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
            continue
        p = _str_split_once(s.get_string(i), sep)
        v = p[part]
        if v == None:
            vals.append("")
            continue
        vals.append(v)
        mk.set(i, 1)
    return make_series_str_with_mask(s.name + "_split", vals, mk)


def df_str_split_expand(df: "DataFrame", name: "str", sep: "str") -> "DataFrame":
    # pandas .str.split(sep, expand=True) cho toi da 2 cot (head/tail).
    # Lan chua duoc tach (khong co sep) -> tail = null.
    c = df.col_by_name(name)
    n = c.length()
    heads = []
    tails = []
    hmk = make_mask(n, 0)
    tmk = make_mask(n, 0)
    for i in range(n):
        if c.is_null(i) == 1:
            heads.append("")
            tails.append("")
            continue
        p = _str_split_once(c.get_string(i), sep)
        heads.append(p[0])
        hmk.set(i, 1)
        if p[1] == None:
            tails.append("")
        else:
            tails.append(p[1])
            tmk.set(i, 1)
    cols = []
    nc = df.column_count()
    for j in range(nc):
        cj = df.col_at(j)
        cols.append(cj.clone_series())
    cols.append(make_series_str_with_mask(name + "_0", heads, hmk))
    cols.append(make_series_str_with_mask(name + "_1", tails, tmk))
    return make_df(cols)


def series_str_nsplit(s: "Series", sep: "str") -> "Series":
    # So phan tu neu tach theo sep (= so lan xuat hien sep + 1)
    if s.dtype != DT_STR:
        raise ValueError("series_str_nsplit: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
            continue
        t = s.get_string(i)
        cnt = 1
        pos = 0
        cap1 = 1
        while cap1 == 1:
            j = t.find(sep, pos)
            if j < 0:
                cap1 = 0
            else:
                cnt = cnt + 1
                pos = j + len(sep)
        vals.append(cnt)
        mk.set(i, 1)
    return make_series_i64_with_mask("nsplit", vals, mk)


# ------------------------------ slice / find ---------------------------------
def series_str_slice(s: "Series", start: "i32", stop: "i32") -> "Series":
    # Python-style: am tinh tu cuoi; stop khong bao gom
    if s.dtype != DT_STR:
        raise ValueError("series_str_slice: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
            continue
        t = s.get_string(i)
        ln = len(t)
        a = start
        b = stop
        if a < 0:
            a = ln + a
        if b < 0:
            b = ln + b
        if a < 0:
            a = 0
        if b > ln:
            b = ln
        if a >= b:
            vals.append("")
        else:
            vals.append(t[a:b])
            mk.set(i, 1)
    return make_series_str_with_mask(s.name + "_slice", vals, mk)


def series_str_find(s: "Series", needle: "str") -> "Series":
    # Vi tri xuat hien dau tien; -1 neu khong co; null -> null
    if s.dtype != DT_STR:
        raise ValueError("series_str_find: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0 - 1)
            continue
        vals.append(s.get_string(i).find(needle))
        mk.set(i, 1)
    return make_series_i64_with_mask("find", vals, mk)


def series_str_contains(s: "Series", needle: "str") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_str_contains: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
            continue
        if s.get_string(i).find(needle) >= 0:
            vals.append(1)
        else:
            vals.append(0)
        mk.set(i, 1)
    return make_series_bool_with_mask("contains", vals, mk)


# ------------------------------ pad / zfill / repeat -------------------------
def series_str_zfill(s: "Series", width: "i32") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_str_zfill: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
            continue
        t = s.get_string(i)
        ln = len(t)
        if ln >= width:
            vals.append(t)
        else:
            k = width - ln
            out = ""
            for j in range(k):
                out = out + "0"
            vals.append(out + t)
        mk.set(i, 1)
    return make_series_str_with_mask(s.name + "_z", vals, mk)


def series_str_pad(s: "Series", width: "i32", side: "str", fill: "str") -> "Series":
    # side: "left" | "right" | "both"
    if s.dtype != DT_STR:
        raise ValueError("series_str_pad: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
            continue
        t = s.get_string(i)
        ln = len(t)
        if ln >= width:
            vals.append(t)
            mk.set(i, 1)
            continue
        k = width - ln
        pads = ""
        for j in range(k):
            pads = pads + fill
        if side == "left":
            vals.append(pads + t)
        elif side == "right":
            vals.append(t + pads)
        else:
            half = k // 2
            vals.append(pads[0:half] + t + pads[half:])
        mk.set(i, 1)
    return make_series_str_with_mask(s.name + "_pad", vals, mk)


def series_str_repeat(s: "Series", times: "i32") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_str_repeat: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
            continue
        t = s.get_string(i)
        out = ""
        for j in range(times):
            out = out + t
        vals.append(out)
        mk.set(i, 1)
    return make_series_str_with_mask(s.name + "_rep", vals, mk)


# ---------------------- title / is-classes / rsplit / join -------------------
def _str_cap_one(t: "str") -> "str":
    # capitalize: ky dau hoa, con lai thuong (Python str.capitalize)
    n = len(t)
    if n == 0:
        return t
    return t[0].upper() + t[1:n].lower()


def series_str_capitalize(s: "Series") -> "Series":
    return series_apply_str(s, lambda t: _str_cap_one(t))


def _str_title_one(t: "str") -> "str":
    # title: hoa chu cai DAU cua moi tu (ky tu truoc do khong la chu cai)
    n = len(t)
    out = ""
    prev_alpha = 0
    for i in range(n):
        ch = t[i]
        c = ch.lower()
        is_alpha = 0
        if c >= "a" and c <= "z":
            is_alpha = 1
        if prev_alpha == 0:
            out = out + ch.upper()
        else:
            out = out + c
        prev_alpha = is_alpha
    return out


def series_str_title(s: "Series") -> "Series":
    return series_apply_str(s, lambda t: _str_title_one(t))


def series_str_lower(s: "Series") -> "Series":
    return series_apply_str(s, lambda t: t.lower())


def series_str_upper(s: "Series") -> "Series":
    return series_apply_str(s, lambda t: t.upper())


def _str_rsplit_once(t: "str", sep: "str") -> "list[str]":
    # Tach tu ben PHAI: [head, tail]; khong gap sep -> [None, t]
    if sep == "":
        raise ValueError("rsplit: separator rong")
    idx = t.rfind(sep)
    if idx < 0:
        parts = []
        parts.append(None)
        parts.append(t)
        return parts
    parts2 = []
    parts2.append(t[0:idx])
    parts2.append(t[idx + len(sep):])
    return parts2


def series_str_rsplit_get(s: "Series", sep: "str", part: "i32") -> "Series":
    # part: 0 = phan truoc lan xuat hien CUOI cung, 1 = phan sau
    if s.dtype != DT_STR:
        raise ValueError("series_str_rsplit_get: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
            continue
        p = _str_rsplit_once(s.get_string(i), sep)
        v = p[part]
        if v == None:
            vals.append("")
            continue
        vals.append(v)
        mk.set(i, 1)
    return make_series_str_with_mask(s.name + "_rsplit", vals, mk)


def series_str_join(s: "Series", sep: "str") -> "str":
    # noi toan bo cot chuoi bang sep (null bo qua)
    n = s.length()
    out = ""
    for i in range(n):
        if i > 0:
            out = out + sep
        if s.is_null(i) == 0:
            out = out + s.get_string(i)
    return out


def _str_all_class(t: "str", mode: "i32") -> "i32":
    # mode 1=isdigit 2=isalpha 3=isalnum: 1 neu TAT CA ky tu thu lop va khong rong
    ln = len(t)
    if ln == 0:
        return 0
    j = 0
    while j < ln:
        c = t[j]
        if mode == 1:
            ok = c >= "0" and c <= "9"
        elif mode == 2:
            cl = c.lower()
            ok = cl >= "a" and cl <= "z"
        else:
            cl = c.lower()
            ok = (cl >= "a" and cl <= "z") or (c >= "0" and c <= "9")
        if ok == 0:
            return 0
        j = j + 1
    return 1


def series_str_isdigit(s: "Series") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_str_isdigit: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
            continue
        vals.append(_str_all_class(s.get_string(i), 1))
        mk.set(i, 1)
    return make_series_bool_with_mask("isdigit", vals, mk)


def series_str_isalpha(s: "Series") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_str_isalpha: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
            continue
        vals.append(_str_all_class(s.get_string(i), 2))
        mk.set(i, 1)
    return make_series_bool_with_mask("isalpha", vals, mk)


def series_str_isalnum(s: "Series") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_str_isalnum: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
            continue
        vals.append(_str_all_class(s.get_string(i), 3))
        mk.set(i, 1)
    return make_series_bool_with_mask("isalnum", vals, mk)


def series_str_startswith(s: "Series", prefix: "str") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_str_startswith: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
            continue
        vals.append(s.get_string(i).startswith(prefix))
        mk.set(i, 1)
    return make_series_bool_with_mask("startswith", vals, mk)


def series_str_endswith(s: "Series", suffix: "str") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_str_endswith: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
            continue
        vals.append(s.get_string(i).endswith(suffix))
        mk.set(i, 1)
    return make_series_bool_with_mask("endswith", vals, mk)


def series_str_replace(s: "Series", old: "str", new: "str") -> "Series":
    # thay chuoi dung (khong regex) - pandas .str.replace dang literal
    if s.dtype != DT_STR:
        raise ValueError("series_str_replace: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
            continue
        vals.append(s.get_string(i).replace(old, new))
        mk.set(i, 1)
    return make_series_str_with_mask(s.name + "_rep", vals, mk)


# =============================================================================
#   Regex API - dan tren builtin re_* cua compiler (.NET Regex, C speed)
# =============================================================================
def re_test(pattern: "str", t: "str") -> "i32":
    # 1 neu pattern khop 1 phan nao do cua t (ngu nghia re.search)
    return re_search(pattern, t)


def re_find(pattern: "str", t: "str") -> "str":
    # match dau tien (toan bo match) hoac None
    ms = re_findall(pattern, t)
    if len(ms) == 0:
        return None
    return ms[0]


def re_count(pattern: "str", t: "str") -> "i32":
    ms = re_findall(pattern, t)
    return len(ms)


def re_find_all(pattern: "str", t: "str") -> "list[str]":
    return re_findall(pattern, t)


# ------------------------ Series-level regex API -----------------------------
def series_str_extract(s: "Series", pattern: "str") -> "Series":
    # pandas .str.extract: lay match dau tien (toan bo match); khong match -> null
    if s.dtype != DT_STR:
        raise ValueError("series_str_extract: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
            continue
        ms = re_findall(pattern, s.get_string(i))
        if len(ms) > 0:
            vals.append(ms[0])
            mk.set(i, 1)
        else:
            vals.append("")
    return make_series_str_with_mask(s.name + "_re", vals, mk)


def series_str_re_test(s: "Series", pattern: "str") -> "Series":
    # bool col: 1 neu khop (pandas .str.match/contains dang regex)
    if s.dtype != DT_STR:
        raise ValueError("series_str_re_test: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
            continue
        vals.append(re_search(pattern, s.get_string(i)))
        mk.set(i, 1)
    return make_series_bool_with_mask(s.name + "_match", vals, mk)


def series_str_replace_re(s: "Series", pattern: "str", repl: "str") -> "Series":
    # thay toan bo match bang chuoi repl (khong backref)
    if s.dtype != DT_STR:
        raise ValueError("series_str_replace_re: cot khong phai str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
            continue
        vals.append(re_sub(pattern, repl, s.get_string(i)))
        mk.set(i, 1)
    return make_series_str_with_mask(s.name + "_repl", vals, mk)

# -*- coding: utf-8 -*-
# =============================================================================
# TokenVector.Data - Module DateTime
# Nen thoi gian: i64 MILLISECONDS depuis Unix epoch (1970-01-01T00:00:00Z).
# Ly do chon ms: - asof_join hien tai so sanh timestamp i64 (quy uoc ms la
#   pho bien cho tick data); - khoang 292 ty nam phu kin; - nhan/chia nguyen
#   an toan trong i64. `dt64` giu nguyen i64 nen toan bo engine (join, sort,
#   groupby) hoat dong voi cot thoi gian KHONG can sua.
# Moi ham THUAN (pure), khong trang thai, timezone duy nhat: UTC.
# =============================================================================

# --------------------- Ngay trong thang (khong nhuan) ------------------------
# (tkvc: module-level list literal khong ho tro -> dung ham _mdays/_mnames/_dnames)
def _mdays(m: "i32") -> "i32":
    if m == 2:
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11:
        return 30
    return 31


def _mnames(m: "i32") -> "str":
    names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    return names[m - 1]


def _dnames(d: "i32") -> "str":
    # d: 0=Mon..6=Sun
    names = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    return names[d]

# ------------------------------ Leap year ------------------------------------
def _dt_is_leap(y: "i32") -> "i32":
    if y % 4 != 0:
        return 0
    if y % 100 != 0:
        return 1
    if y % 400 == 0:
        return 1
    return 0


def _dt_days_in_month(y: "i32", m: "i32") -> "i32":
    if m == 2 and _dt_is_leap(y) == 1:
        return 29
    return _mdays(m)


# So ngay depuis 1970-01-01 (proleptic Gregorian) -> (y, m, d)
def _dt_civil_from_days(z: "i64") -> "list[i32]":
    # Thuat toan Howard Hinnant (civil_from_days), i64; day 0 = 1970-01-01.
    n = z + 719468
    era = n // 146097
    if n - era * 146097 < 0:
        era = era - 1
    doe = n - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    yy = yoe + era * 400
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    dd = doy - (153 * mp + 2) // 5 + 1
    mm = mp + 3
    if mp >= 10:
        mm = mm - 12
    if mm <= 2:
        yy = yy + 1
    return [yy, mm, dd]


def _dt_days_from_civil(y: "i32", m: "i32", d: "i32") -> "i64":
    # Howard Hinnant (algorithm days_from_civil), i64.
    yy = y
    if m <= 2:
        yy = y - 1
    era = yy // 400
    if yy - era * 400 < 0:
        era = era - 1
    yoe = yy - era * 400
    mp = m + 9
    if m > 2:
        mp = m - 3
    doy = (153 * mp + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468


# ============================ Parse & Format =================================
# dt_parse("2024-03-15 10:30:00.500") -> i64 ms epoch
# Chap nhan: "YYYY-MM-DD", "YYYY-MM-DD HH", "YYYY-MM-DD HH:MM",
# "YYYY-MM-DD HH:MM:SS", them ".fff" (1-6 chu so) va phan cuoi "Z" / "+HH:MM"
# (offset duoc tru di de tra ve UTC).
def dt_parse(s: "str") -> "i64":
    t = s.strip()
    ln = len(t)
    if ln < 10:
        raise ValueError("dt_parse: chuoi qua ngan: " + s)
    yy = int(t[0:4])
    mm = int(t[5:7])
    dd = int(t[8:10])
    if mm < 1 or mm > 12 or dd < 1 or dd > _dt_days_in_month(yy, mm):
        raise ValueError("dt_parse: ngay khong hop le: " + s)
    hh = 0
    mi = 0
    ss = 0
    ms = 0
    off_ms = 0
    i = 10
    if i < ln and (t[i] == "T" or t[i] == " "):
        i = i + 1
        if i + 1 < ln:
            hh = int(t[i:i + 2])
            i = i + 2
            if i < ln and t[i] == ":":
                i = i + 1
                mi = int(t[i:i + 2])
                i = i + 2
                if i < ln and t[i] == ":":
                    i = i + 1
                    ss = int(t[i:i + 2])
                    i = i + 2
                    if i < ln and t[i] == ".":
                        j = i + 1
                        while j < ln and t[j] >= "0" and t[j] <= "9":
                            j = j + 1
                        frac = t[i + 1:j]
                        ms = int(frac)
                        # 1 chu so -> x100, 2 chu so -> x10, 3+ -> lam tron ms
                        fl = len(frac)
                        if fl == 1:
                            ms = ms * 100
                        elif fl == 2:
                            ms = ms * 10
                        elif fl > 3:
                            ms = int(frac[0:3])
                        i = j
        if i < ln:
            c = t[i]
            if c == "Z" or c == "z":
                i = i + 1
            elif c == "+" or c == "-":
                sgn = 1
                if c == "-":
                    sgn = 0 - 1
                oh = int(t[i + 1:i + 3])
                om = 0
                if i + 3 < ln and t[i + 3] == ":":
                    om = int(t[i + 4:i + 6])
                off_ms = sgn * (oh * 3600000 + om * 60000)
                i = i + 6
    if i < ln:
        raise ValueError("dt_parse: ky tu du khong xac dinh: " + s)
    if hh > 23 or mi > 59 or ss > 60:
        raise ValueError("dt_parse: gio phut giay khong hop le: " + s)
    days = _dt_days_from_civil(yy, mm, dd)
    return days * 86400000 + hh * 3600000 + mi * 60000 + ss * 1000 + ms - off_ms


def _dt_pad2(v: "i32") -> "str":
    if v < 10:
        return "0" + str(v)
    return str(v)


def _dt_pad3(v: "i32") -> "str":
    if v < 10:
        return "00" + str(v)
    if v < 100:
        return "0" + str(v)
    return str(v)


# dt_format(ms, fmt) - fmt giong Python strftime co ban:
# %Y %m %d %H %M %S %f (ms 3 chu so) %b %p %Z(luon "UTC") %% ; "" -> ISO full
def dt_format(ms: "i64", fmt: "str") -> "str":
    day0 = ms // 86400000
    rem = ms - day0 * 86400000
    if rem < 0:
        rem = rem + 86400000
        day0 = day0 - 1
    ymd = _dt_civil_from_days(day0)
    yy = ymd[0]
    mm = ymd[1]
    dd = ymd[2]
    hh = rem // 3600000
    rem2 = rem - hh * 3600000
    mi = rem2 // 60000
    rem3 = rem2 - mi * 60000
    ss = rem3 // 1000
    msss = rem3 - ss * 1000
    if fmt == "":
        return str(yy) + "-" + _dt_pad2(mm) + "-" + _dt_pad2(dd) + " " + _dt_pad2(hh) + ":" + _dt_pad2(mi) + ":" + _dt_pad2(ss) + "." + _dt_pad3(msss)
    out = ""
    k = 0
    ln = len(fmt)
    while k < ln:
        ch = fmt[k]
        if ch == "%" and k + 1 < ln:
            code = fmt[k + 1]
            if code == "Y":
                out = out + str(yy)
            elif code == "m":
                out = out + _dt_pad2(mm)
            elif code == "d":
                out = out + _dt_pad2(dd)
            elif code == "H":
                out = out + _dt_pad2(hh)
            elif code == "M":
                out = out + _dt_pad2(mi)
            elif code == "S":
                out = out + _dt_pad2(ss)
            elif code == "f":
                out = out + _dt_pad3(msss)
            elif code == "b":
                out = out + _mnames(mm)
            elif code == "p":
                if hh < 12:
                    out = out + "AM"
                else:
                    out = out + "PM"
            elif code == "Z":
                out = out + "UTC"
            elif code == "%":
                out = out + "%"
            else:
                out = out + ch + code
            k = k + 2
        else:
            out = out + ch
            k = k + 1
    return out


# ISO mac dinh cho column repr
def dt_format_iso(ms: "i64") -> "str":
    return dt_format(ms, "")


# ============================ Component access ===============================
def dt_year(ms: "i64") -> "i32":
    return _dt_civil_from_days(ms // 86400000)[0]


def dt_month(ms: "i64") -> "i32":
    return _dt_civil_from_days(ms // 86400000)[1]


def dt_day(ms: "i64") -> "i32":
    return _dt_civil_from_days(ms // 86400000)[2]


def dt_hour(ms: "i64") -> "i32":
    rem = ms % 86400000
    if rem < 0:
        rem = rem + 86400000
    return rem // 3600000


def dt_minute(ms: "i64") -> "i32":
    rem = ms % 86400000
    if rem < 0:
        rem = rem + 86400000
    return (rem // 60000) % 60


def dt_second(ms: "i64") -> "i32":
    rem = ms % 86400000
    if rem < 0:
        rem = rem + 86400000
    return (rem // 1000) % 60


def dt_millisecond(ms: "i64") -> "i32":
    rem = ms % 86400000
    if rem < 0:
        rem = rem + 86400000
    return rem % 1000


# Thu trong tuan: 0=Mon .. 6=Sun (giong pandas dayofweek)
def dt_weekday(ms: "i64") -> "i32":
    day0 = ms // 86400000
    wd = day0 % 7
    if wd < 0:
        wd = wd + 7
    # 1970-01-01 = Thursday. Civil epoch -> weekday thu: Mon=0
    wd = wd + 3
    if wd >= 7:
        wd = wd - 7
    return wd


def dt_day_name(ms: "i64") -> "str":
    return _dnames(dt_weekday(ms))


def dt_month_name(ms: "i64") -> "str":
    return _mnames(dt_month(ms))


# ============================== Arithmetic ===================================
def dt_add_days(ms: "i64", k: "i32") -> "i64":
    return ms + k * 86400000


def dt_add_hours(ms: "i64", k: "i32") -> "i64":
    return ms + k * 3600000


def dt_add_minutes(ms: "i64", k: "i32") -> "i64":
    return ms + k * 60000


def dt_add_seconds(ms: "i64", k: "i32") -> "i64":
    return ms + k * 1000


def dt_diff_days(a: "i64", b: "i64") -> "i64":
    return (a - b) // 86400000


# ============================== dt_range =====================================
# Sinh day moc thoi gian deu nhau tu start, buoc "n<unit>".
# unit: "D" ngay, "H" gio, "T"/"min" phut, "S" giay, "W" tuan, "M" thang,
# "Y" nam (M/Y theo lich - moi buoc tinh lai tu ngay dau, giong pandas).
# Tra ve Series i64 ten "ts".
def dt_range(start: "str", periods: "i32", freq: "str") -> "Series":
    ms0 = dt_parse(start)
    nu = len(freq)
    if nu < 1:
        raise ValueError("dt_range: freq rong")
    num = 1
    unit = freq
    if nu > 1 and freq[0] >= "0" and freq[0] <= "9":
        # so buoc nam truoc: "3D", "15T"...
        j = 0
        while j < nu and freq[j] >= "0" and freq[j] <= "9":
            j = j + 1
        num = int(freq[0:j])
        unit = freq[j:]
    vals = []
    cur_y = dt_year(ms0)
    cur_m = dt_month(ms0)
    cur_d = dt_day(ms0)
    tod = ms0 % 86400000  # thoi diem trong ngay (gio:phut:giay.ms)
    cur = ms0
    for i in range(periods):
        vals.append(cur)
        if unit == "M":
            cur_m = cur_m + num
            while cur_m > 12:
                cur_m = cur_m - 12
                cur_y = cur_y + 1
            dmax = _dt_days_in_month(cur_y, cur_m)
            d_eff = cur_d
            if d_eff > dmax:
                d_eff = dmax
            cur = _dt_days_from_civil(cur_y, cur_m, d_eff) * 86400000 + tod
        elif unit == "Y":
            cur_y = cur_y + num
            dmax = _dt_days_in_month(cur_y, cur_m)
            d_eff = cur_d
            if d_eff > dmax:
                d_eff = dmax
            cur = _dt_days_from_civil(cur_y, cur_m, d_eff) * 86400000 + tod
        elif unit == "W":
            cur = cur + num * 604800000
        elif unit == "D":
            cur = cur + num * 86400000
        elif unit == "H":
            cur = cur + num * 3600000
        elif unit == "T" or unit == "min":
            cur = cur + num * 60000
        elif unit == "S":
            cur = cur + num * 1000
        else:
            raise ValueError("dt_range: freq unit khong ho tro: " + unit)
    return make_series_i64("ts", vals)


# ============================== Resample =====================================
# Gom cot thoi gian i64 "ts_col" + cot gia tri f64 "val_col" thanh cac bucket
# freq (dt_range), moi bucket 1 gia tri agg. Mo moc moc bucket dong trai.
# agg_type: AGG_SUM/MEAN/MIN/MAX/COUNT (dung bang hang so module relational).
def resample(df: "DataFrame", ts_col: "str", val_col: "str", freq: "str", agg_type: "i32") -> "DataFrame":
    tc = df.col_by_name(ts_col)
    vc = df.col_by_name(val_col)
    n = tc.length()
    if n == 0:
        return empty_df()
    if tc.dtype != DT_I64:
        raise ValueError("resample: cot thoi gian phai la i64 (epoch ms)")
    t0 = tc.get_i64(0)
    for i in range(1, n):
        v = tc.get_i64(i)
        if v < t0:
            t0 = v
    # mo moc bucket dau tien: khoi phuoc y/m/d de dua bucket ve ranh thuan
    y = dt_year(t0)
    m = dt_month(t0)
    d = dt_day(t0)
    h = dt_hour(t0)
    unit = freq[len(freq) - 1]
    num = 1
    if len(freq) > 1 and freq[0] >= "0" and freq[0] <= "9":
        num = int(freq[0:len(freq) - 1])
    if unit == "M":
        b0 = _dt_days_from_civil(y, m, 1) * 86400000
    elif unit == "Y":
        b0 = _dt_days_from_civil(y, 1, 1) * 86400000
    elif unit == "D" or unit == "W":
        b0 = _dt_days_from_civil(y, m, d) * 86400000
    elif unit == "H":
        b0 = _dt_days_from_civil(y, m, d) * 86400000 + h * 3600000
    elif unit == "T" or unit == "min":
        day0 = _dt_days_from_civil(y, m, d) * 86400000
        b0 = t0 - ((t0 - day0) % (num * 60000))
    elif unit == "S":
        day0 = _dt_days_from_civil(y, m, d) * 86400000
        b0 = t0 - ((t0 - day0) % (num * 1000))
    else:
        raise ValueError("resample: freq unit khong ho tro: " + unit)
    # kich thuoc bucket giay/D/H/T/S la hang so; M/Y bien thien - xu ly rieng
    if unit == "M" or unit == "Y":
        # di tung bucket lich
        out_t = []
        out_v = []
        cy = y
        cm = m
        if unit == "Y":
            cm = 1
        if unit == "M":
            cm = ((cm - 1) // num) * num + 1
        cap = 1
        while cap == 1:
            ny = cy
            nm2 = cm
            if unit == "Y":
                ny = cy + num
            else:
                nm2 = cm + num
                while nm2 > 12:
                    nm2 = nm2 - 12
                    ny = ny + 1
            bend = _dt_days_from_civil(ny, nm2, 1) * 86400000
            # gather rows in [b0, bend)
            vals = []
            for i in range(n):
                tv = tc.get_i64(i)
                if tv >= b0 and tv < bend and vc.is_null(i) == 0:
                    vals.append(vc.get_f64(i))
            if len(vals) > 0:
                out_t.append(b0)
                out_v.append(_dt_agg_reduce(vals, agg_type))
            if bend > tc.get_i64(n - 1):
                cap = 0
            b0 = bend
            cy = ny
            cm = nm2
        return make_df([make_series_i64("ts", out_t), make_series_f64(val_col, out_v)])
    step = num * 1000
    if unit == "T" or unit == "min":
        step = num * 60000
    elif unit == "H":
        step = num * 3600000
    elif unit == "D":
        step = num * 86400000
    elif unit == "W":
        step = num * 604800000
    # fixed-size: diem tung dong 1 lan (O(n))
    total = (tc.get_i64(n - 1) - b0) // step + 1
    sums = []
    cnts = []
    fmin = []
    fmax = []
    for i in range(total):
        sums.append(0.0)
        cnts.append(0)
        fmin.append(0.0)
        fmax.append(0.0)
    for i in range(n):
        tv = tc.get_i64(i)
        if vc.is_null(i) == 1:
            continue
        b = (tv - b0) // step
        if b < 0:
            continue
        x = vc.get_f64(i)
        sums[b] = sums[b] + x
        cnts[b] = cnts[b] + 1
        if cnts[b] == 1:
            fmin[b] = x
            fmax[b] = x
        else:
            if x < fmin[b]:
                fmin[b] = x
            if x > fmax[b]:
                fmax[b] = x
    out_t = []
    out_v = []
    for b in range(total):
        if cnts[b] > 0:
            out_t.append(b0 + b * step)
            if agg_type == AGG_SUM:
                out_v.append(sums[b])
            elif agg_type == AGG_MEAN:
                out_v.append(sums[b] / float(cnts[b]))
            elif agg_type == AGG_MIN:
                out_v.append(fmin[b])
            elif agg_type == AGG_MAX:
                out_v.append(fmax[b])
            elif agg_type == AGG_COUNT:
                out_v.append(float(cnts[b]))
            else:
                out_v.append(sums[b] / float(cnts[b]))
    return make_df([make_series_i64("ts", out_t), make_series_f64(val_col, out_v)])


def _dt_agg_reduce(vals: "list[f64]", agg_type: "i32") -> "f64":
    total = 0.0
    smin = vals[0]
    smax = vals[0]
    for i in range(len(vals)):
        x = vals[i]
        total = total + x
        if x < smin:
            smin = x
        if x > smax:
            smax = x
    if agg_type == AGG_SUM:
        return total
    if agg_type == AGG_MEAN:
        return total / float(len(vals))
    if agg_type == AGG_MIN:
        return smin
    if agg_type == AGG_MAX:
        return smax
    if agg_type == AGG_COUNT:
        return float(len(vals))
    return total / float(len(vals))


# ======================= Series helpers (map per-row) ========================
def series_dt_parse(s: "Series") -> "Series":
    if s.dtype != DT_STR:
        raise ValueError("series_dt_parse: cot dau vao phai la str")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
        else:
            vals.append(dt_parse(s.get_string(i)))
            mk.set(i, 1)
    out = make_series_i64_with_mask("ts", vals, mk)
    return out


def series_dt_format(s: "Series", fmt: "str") -> "Series":
    if s.dtype != DT_I64:
        raise ValueError("series_dt_format: cot dau vao phai la i64 epoch ms")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append("")
        else:
            vals.append(dt_format(s.get_i64(i), fmt))
            mk.set(i, 1)
    return make_series_str_with_mask("dt", vals, mk)


def series_dt_part(s: "Series", which: "str") -> "Series":
    # which: "year"|"month"|"day"|"hour"|"minute"|"second"|"weekday"|"ms"
    if s.dtype != DT_I64:
        raise ValueError("series_dt_part: cot dau vao phai la i64 epoch ms")
    n = s.length()
    vals = []
    mk = make_mask(n, 0)
    for i in range(n):
        if s.is_null(i) == 1:
            vals.append(0)
            continue
        v = s.get_i64(i)
        mk.set(i, 1)
        if which == "year":
            vals.append(dt_year(v))
        elif which == "month":
            vals.append(dt_month(v))
        elif which == "day":
            vals.append(dt_day(v))
        elif which == "hour":
            vals.append(dt_hour(v))
        elif which == "minute":
            vals.append(dt_minute(v))
        elif which == "second":
            vals.append(dt_second(v))
        elif which == "weekday":
            vals.append(dt_weekday(v))
        elif which == "ms":
            vals.append(dt_millisecond(v))
        else:
            raise ValueError("series_dt_part: khong biet phan: " + which)
    return make_series_i64_with_mask(s.name + "_" + which, vals, mk)


# -*- coding: utf-8 -*-
# tokenvector_io.tkv - port tu C# TokenVector.Data/IO

Q = "\""


# ------------------------------ CSV parsing -----------------------------------
def _split_csv_line(line: "str", delimiter: "str", quote: "str") -> "list[str]":
    fields = []
    cur = ""
    in_quotes = 0
    i = 0
    ln = len(line)
    while i < ln:
        ch = line[i]
        if ch == quote:
            if in_quotes == 1:
                if i + 1 < ln:
                    nxt = line[i + 1]
                    if nxt == quote:
                        cur = cur + quote
                        i = i + 1
                    else:
                        in_quotes = 0
                else:
                    in_quotes = 0
            else:
                in_quotes = 1
        elif ch == delimiter and in_quotes == 0:
            fields.append(cur)
            cur = ""
        else:
            cur = cur + ch
        i = i + 1
    fields.append(cur)
    return fields


def csv_parse_rows(text: "str", delimiter: "str", quote: "str") -> "list[str]":
    # Moi row tra ve la chuoi ghep cac field bang ky tu US
    rows = []
    lines = text.split("\n")
    n_lines = len(lines)
    i = 0
    while i < n_lines:
        raw = lines[i]
        line = raw.replace("\r", "")
        if line == "" and i == n_lines - 1:
            break
        if line.find(quote) == 0 - 1:
            # fast path: khong co quote trong dong -> dung builtin split
            fields = line.split(delimiter)
        else:
            fields = _split_csv_line(line, delimiter, quote)
        joined = fields[0]
        for f in range(1, len(fields)):
            joined = joined + "" + fields[f]
        rows.append(joined)
        i = i + 1
    return rows


def _row_fields(joined: "str") -> "list[str]":
    if joined == "":
        return [""]
    return joined.split("")


def _try_parse_i64(s: "str") -> "i64":
    neg = 1
    t = s.strip()
    if len(t) == 0:
        return 0
    if t[0] == "-":
        neg = 0 - 1
        t = t[1:]
    elif t[0] == "+":
        t = t[1:]
    if len(t) == 0:
        return 0
    total = 0
    for i in range(len(t)):
        ch = t[i]
        if ch < "0" or ch > "9":
            return 0
        d = 0
        if ch == "0":
            d = 0
        elif ch == "1":
            d = 1
        elif ch == "2":
            d = 2
        elif ch == "3":
            d = 3
        elif ch == "4":
            d = 4
        elif ch == "5":
            d = 5
        elif ch == "6":
            d = 6
        elif ch == "7":
            d = 7
        elif ch == "8":
            d = 8
        elif ch == "9":
            d = 9
        total = total * 10 + d
    return total * neg


def _is_int(s: "str") -> "i32":
    t = s.strip()
    if len(t) == 0:
        return 0
    if t[0] == "-" or t[0] == "+":
        t = t[1:]
    if len(t) == 0:
        return 0
    for i in range(len(t)):
        ch = t[i]
        if ch < "0" or ch > "9":
            return 0
    return 1


def _is_float(s: "str") -> "i32":
    t = s.strip()
    if len(t) == 0:
        return 0
    has_digit = 0
    has_dot = 0
    for i in range(len(t)):
        ch = t[i]
        if ch >= "0" and ch <= "9":
            has_digit = 1
        elif ch == "." and has_dot == 0:
            has_dot = 1
        elif (ch == "-" or ch == "+") and i == 0:
            has_digit = has_digit
        elif (ch == "e" or ch == "E") and has_digit == 1:
            has_digit = has_digit
        else:
            return 0
    if has_digit == 0:
        return 0
    return 1


def _is_bool(s: "str") -> "i32":
    t = s.strip().lower()
    if t == "true" or t == "false":
        return 1
    return 0


def csv_infer_dtypes(rows: "list[str]", data_start: "i32", n_cols: "i32", null_value: "str") -> "list[i32]":
    n_rows = len(rows)
    dtypes = []
    for c in range(n_cols):
        is_int = 1
        is_float = 1
        is_bool = 1
        tested = 0
        for r in range(data_start, n_rows):
            fields = _row_fields(rows[r])
            if c >= len(fields):
                continue
            val = fields[c].strip()
            if val == "" or val == null_value:
                continue
            tested = tested + 1
            if is_int == 1 and _is_int(val) == 0:
                is_int = 0
                if _is_float(val) == 0:
                    is_float = 0
                if _is_bool(val) == 0:
                    is_bool = 0
            elif is_int == 1:
                # cell pure-digit: float chac chan pass, bool chac chan fail
                is_bool = 0
        if tested == 0:
            dtypes.append(DT_STR)
        elif is_bool == 1:
            dtypes.append(DT_BOOL)
        elif is_int == 1:
            dtypes.append(DT_I64)
        elif is_float == 1:
            dtypes.append(DT_F64)
        else:
            dtypes.append(DT_STR)
    return dtypes


def _infer_dtypes_grid(grid: "list[str]", n_cols: "i32", total_data: "i32", null_value: "str") -> "list[i32]":
    dtypes = []
    for c in range(n_cols):
        is_int = 1
        is_float = 1
        is_bool = 1
        tested = 0
        for r in range(total_data):
            val = grid[r * n_cols + c].strip()
            if val == "" or val == null_value:
                continue
            tested = tested + 1
            if is_int == 1 and _is_int(val) == 0:
                is_int = 0
                if _is_float(val) == 0:
                    is_float = 0
                if _is_bool(val) == 0:
                    is_bool = 0
            elif is_int == 1:
                # cell pure-digit: float chac chan pass, bool chac chan fail
                is_bool = 0
        if tested == 0:
            dtypes.append(DT_STR)
        elif is_bool == 1:
            dtypes.append(DT_BOOL)
        elif is_int == 1:
            dtypes.append(DT_I64)
        elif is_float == 1:
            dtypes.append(DT_F64)
        else:
            dtypes.append(DT_STR)
    return dtypes


def csv_read_string(csv_text: "str", delimiter: "str", has_header: "i32", null_value: "str") -> "DataFrame":
    # Single-pass v2: split moi dong DUY NHAT 1 lan thang vao grid (khong qua
    # csv_parse_rows -> bo join US + split US quay lai); infer 1 pass short-circuit;
    # parse truc tiep theo dtype da biet (khong re-validate).
    if csv_text == "":
        return empty_df()
    lines = csv_text.split("\n")
    n_lines = len(lines)
    column_names = []
    data_start = 0
    if has_header == 1:
        header_line = lines[0]
        hl = len(header_line)
        if hl > 0 and header_line[hl - 1] == "\r":
            header_line = header_line[0:hl - 1]
        header_fields = _split_csv_line(header_line, delimiter, "\"")
        for f in range(len(header_fields)):
            column_names.append(header_fields[f])
        data_start = 1
    else:
        if n_lines > 0:
            first_line = lines[0]
            fl = len(first_line)
            if fl > 0 and first_line[fl - 1] == "\r":
                first_line = first_line[0:fl - 1]
            first_fields = _split_csv_line(first_line, delimiter, "\"")
            n_first = len(first_fields)
            for i in range(n_first):
                column_names.append("column_" + str(i))
        else:
            column_names.append("column_0")
    n_cols = len(column_names)
    if data_start >= n_lines:
        result_cols = []
        for c in range(n_cols):
            result_cols.append(make_series_str(column_names[c], []))
        return make_df(result_cols)
    grid = []
    total_data = 0
    for i in range(data_start, n_lines):
        line = lines[i]
        ln = len(line)
        if ln > 0 and line[ln - 1] == "\r":
            line = line[0:ln - 1]
        if line == "" and i == n_lines - 1:
            break
        if line.find("\"") == 0 - 1:
            fields = line.split(delimiter)
        else:
            fields = _split_csv_line(line, delimiter, "\"")
        nf = len(fields)
        for c in range(n_cols):
            if c < nf:
                grid.append(fields[c])
            else:
                grid.append("")
        total_data = total_data + 1
    if total_data == 0:
        result_cols = []
        for c in range(n_cols):
            result_cols.append(make_series_str(column_names[c], []))
        return make_df(result_cols)
    dtypes = _infer_dtypes_grid(grid, n_cols, total_data, null_value)
    result_cols = []
    for c in range(n_cols):
        col_name = column_names[c]
        dt = dtypes[c]
        if dt == DT_I64:
            ivals = []
            vm = make_mask(total_data, 1)
            for i in range(total_data):
                raw = grid[i * n_cols + c].strip()
                if raw == "" or raw == null_value:
                    ivals.append(0)
                    vm.set(i, 0)
                else:
                    # infer da dam bao pure-int; int() nhanh hon manual per-char
                    ivals.append(int(raw))
            c2 = make_col_i64_with_mask(ivals, vm)
            result_cols.append(make_series(col_name, c2))
        elif dt == DT_BOOL:
            bvals = []
            vm = make_mask(total_data, 1)
            for i in range(total_data):
                raw = grid[i * n_cols + c].strip().lower()
                if raw == "true":
                    bvals.append(1)
                elif raw == "false":
                    bvals.append(0)
                else:
                    bvals.append(0)
                    vm.set(i, 0)
            c2 = make_col_bool_with_mask(bvals, vm)
            result_cols.append(make_series(col_name, c2))
        elif dt == DT_F64:
            fvals = []
            vm = make_mask(total_data, 1)
            for i in range(total_data):
                raw = grid[i * n_cols + c].strip()
                if raw == "" or raw == null_value:
                    fvals.append(0.0)
                    vm.set(i, 0)
                else:
                    fvals.append(float(raw))
            c2 = make_col_f64_with_mask(fvals, vm)
            result_cols.append(make_series(col_name, c2))
        else:
            strs = []
            for i in range(total_data):
                val = grid[i * n_cols + c]
                if val == null_value:
                    strs.append(None)
                else:
                    strs.append(val)
            result_cols.append(make_series_str(col_name, strs))
    return make_df(result_cols)


def csv_read_file(file_path: "str", delimiter: "str", has_header: "i32", null_value: "str") -> "DataFrame":
    if file_exists(file_path) == 0:
        raise ValueError("File not found: " + file_path)
    text = read_file(file_path)
    return csv_read_string(text, delimiter, has_header, null_value)


# ------------------------------ CSV writing -----------------------------------
def _csv_escape(value: "str", delimiter: "str", quote: "str") -> "str":
    if value.find(delimiter) >= 0 or value.find(quote) >= 0 or value.find("\n") >= 0 or value.find("\r") >= 0:
        out = quote
        for i in range(len(value)):
            ch = value[i]
            if ch == quote:
                out = out + quote + quote
            else:
                out = out + ch
        return out + quote
    return value


def csv_write_string(df: "DataFrame", delimiter: "str", include_header: "i32", null_value: "str") -> "str":
    n_cols = df.column_count()
    n_rows = df.row_count()
    names = df_column_names(df)
    lines = []

    if include_header == 1:
        header = ""
        for c in range(n_cols):
            if c > 0:
                header = header + delimiter
            header = header + _csv_escape(names[c], delimiter, "\"")
        lines.append(header)

    for r in range(n_rows):
        line = ""
        for c in range(n_cols):
            if c > 0:
                line = line + delimiter
            col = df.col_at(c)
            if col.is_null(r) == 1:
                line = line + null_value
            else:
                val = col.get_string(r)
                line = line + _csv_escape(val, delimiter, "\"")
        lines.append(line)

    out = ""
    for i in range(len(lines)):
        if i > 0:
            out = out + "\n"
        out = out + lines[i]
    return out + "\n"


def csv_write_file(df: "DataFrame", file_path: "str", delimiter: "str", include_header: "i32", null_value: "str") -> "i32":
    text = csv_write_string(df, delimiter, include_header, null_value)
    write_file(file_path, text)
    return 0


# ------------------------------ JSON parsing ----------------------------------
def _json_skip_ws(s: "str", i: "i32") -> "i32":
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r":
            i = i + 1
        else:
            break
    return i


def _hex_digit(ch: "str") -> "i32":
    if ch >= "0" and ch <= "9":
        if ch == "0":
            return 0
        if ch == "1":
            return 1
        if ch == "2":
            return 2
        if ch == "3":
            return 3
        if ch == "4":
            return 4
        if ch == "5":
            return 5
        if ch == "6":
            return 6
        if ch == "7":
            return 7
        if ch == "8":
            return 8
        return 9
    t = ch.lower()
    if t == "a":
        return 10
    if t == "b":
        return 11
    if t == "c":
        return 12
    if t == "d":
        return 13
    if t == "e":
        return 14
    if t == "f":
        return 15
    return 0


def _hex4(s: "str") -> "i32":
    v = _hex_digit(s[0]) * 4096 + _hex_digit(s[1]) * 256 + _hex_digit(s[2]) * 16 + _hex_digit(s[3])
    return v


def _str_before_sep(s: "str") -> "str":
    p = s.find("")
    if p < 0:
        return s
    return s[0:p]


def _str_after_sep(s: "str") -> "str":
    p = s.find("")
    if p < 0:
        return ""
    q = p + 1
    return s[q:len(s)]


def _json_parse_string(s: "str", i: "i32") -> "str":
    # s[i] == '"'; tra ve (value, next_i)
    out = ""
    i = i + 1
    n = len(s)
    while i < n:
        ch = s[i]
        if ch == "\\" and i + 1 < n:
            esc = s[i + 1]
            if esc == "n":
                out = out + "\n"
            elif esc == "t":
                out = out + "\t"
            elif esc == "r":
                out = out + "\r"
            elif esc == "u" and i + 5 < n:
                # uXXXX escape bo qua
                i = i + 4
            else:
                out = out + esc
            i = i + 2
        elif ch == Q:
            return str(i + 1) + "" + out
        else:
            out = out + ch
            i = i + 1
    return str(i) + "" + out


def _json_parse_number(s: "str", i: "i32") -> "str":
    # tra ve "next_iUSkindUSvalue": kind 3=i64, 4=f64
    n = len(s)
    j = i
    is_float = 0
    while j < n:
        ch = s[j]
        if (ch >= "0" and ch <= "9") or ch == "-" or ch == "+":
            j = j + 1
        elif ch == "." or ch == "e" or ch == "E":
            is_float = 1
            j = j + 1
        else:
            break
    raw = s[i:j]
    if is_float == 1:
        return str(j) + "4" + str(float(raw))
    return str(j) + "3" + str(_try_parse_i64(raw))


def _json_parse_value(s: "str", i: "i32") -> "str":
    # tra ve "next_iUSkindUSvalue": 0=str, 3=i64, 4=f64, 5=bool, 6=null
    i = _json_skip_ws(s, i)
    n = len(s)
    if i >= n:
        return str(i) + "6"
    ch = s[i]
    if ch == Q:
        pair = _json_parse_string(s, i)
        return _str_before_sep(pair) + "0" + _str_after_sep(pair)
    if ch == "t" and s.find("true", i) == i:
        return str(i + 4) + "5" + "True"
    if ch == "f" and s.find("false", i) == i:
        return str(i + 5) + "5" + "False"
    if ch == "n" and s.find("null", i) == i:
        return str(i + 4) + "6"
    return _json_parse_number(s, i)


def _json_find_matching(s: "str", i: "i32", open_ch: "str", close_ch: "str") -> "i32":
    depth = 0
    n = len(s)
    j = i
    while j < n:
        cj = s[j]
        if cj == Q:
            pair = _json_parse_string(s, j)
            j = int(_str_before_sep(pair))
            continue
        if cj == open_ch:
            depth = depth + 1
        elif cj == close_ch:
            depth = depth - 1
            if depth == 0:
                return j
        j = j + 1
    return 0 - 1


# kind codes dung trong luu tru row
def _parse_json_object_kv(obj_text: "str", all_keys: "list[str]") -> "str":
    # obj_text dang "{...}"; tra ve row_text: cac cap "keyUSkind_tagUSvalue" ghep RS
    inner = obj_text[1:len(obj_text) - 1]
    n = len(inner)
    i = 0
    chunks = ["<seed>"]
    while i < n:
        i = _json_skip_ws(inner, i)
        if i >= n:
            break
        if inner[i] == ",":
            i = i + 1
            continue
        if inner[i] == Q:
            kp = _json_parse_string(inner, i)
            key = _str_after_sep(kp)
            i = int(_str_before_sep(kp))
            i = _json_skip_ws(inner, i)
            if i < n and inner[i] == ":":
                i = i + 1
            vp = _json_parse_value(inner, i)
            vparts = vp.split("")
            i = int(vparts[0])
            kind = int(vparts[1])
            val = vparts[2]
            if kind == 6:
                tag = "<N>"
                sval = ""
            elif kind == 5:
                tag = "<B>"
                sval = str(val)
            elif kind == 3 or kind == 4:
                tag = "<#>"
                sval = str(val)
            else:
                tag = "<S>"
                sval = val
            chunks.append(key + "" + tag + "" + sval)
            seen = 0
            for k in range(len(all_keys)):
                if all_keys[k] == key:
                    seen = 1
                    break
            if seen == 0:
                all_keys.append(key)
        else:
            i = i + 1
    row_text = ""
    for c in range(len(chunks)):
        if c > 0:
            row_text = row_text + ""
        row_text = row_text + chunks[c]
    return row_text


def _row_get_tag(row_text: "str", key: "str") -> "str":
    if row_text == "":
        return ""
    items = row_text.split("")
    for it in range(len(items)):
        item1 = items[it]
        parts = item1.split("")
        if parts[0] == key:
            return parts[1]
    return ""


def _row_get_val(row_text: "str", key: "str") -> "str":
    if row_text == "":
        return ""
    items = row_text.split("")
    for it in range(len(items)):
        item2 = items[it]
        parts = item2.split("")
        if parts[0] == key:
            return parts[2]
    return ""


def _ndjson_rows(ndjson_text: "str", all_keys: "list[str]") -> "list[str]":
    lines = ndjson_text.split("\n")
    row_texts = []
    n_lines = len(lines)
    for li in range(n_lines):
        line = lines[li].strip()
        if line == "":
            continue
        row_texts.append(_parse_json_object_kv(line, all_keys))
    return row_texts


def ndjson_read_string(ndjson_text: "str") -> "DataFrame":
    all_keys = []
    row_texts = _ndjson_rows(ndjson_text, all_keys)
    if len(row_texts) == 0 or len(all_keys) == 0:
        return empty_df()

    n_rows = len(row_texts)
    result_cols = []
    for k in range(len(all_keys)):
        key = all_keys[k]
        is_num = 1
        is_bool = 1
        non_null = 0
        for r in range(n_rows):
            tag = _row_get_tag(row_texts[r], key)
            if tag != "":
                non_null = non_null + 1
                if tag != "<#>":
                    is_num = 0
                if tag != "<B>":
                    is_bool = 0
        if is_bool == 1 and non_null > 0:
            bvals = []
            vm = make_mask(n_rows, 1)
            for r in range(n_rows):
                val = _row_get_val(row_texts[r], key)
                if val == "True" or val == "true" or val == "1":
                    bvals.append(1)
                elif val == "False" or val == "false" or val == "0":
                    bvals.append(0)
                else:
                    bvals.append(0)
                    vm.set(r, 0)
            c2 = make_col_bool_with_mask(bvals, vm)
            result_cols.append(make_series(key, c2))
        elif is_num == 1 and non_null > 0:
            is_all_int = 1
            for r in range(n_rows):
                val = _row_get_val(row_texts[r], key)
                if val != "" and val.find(".") >= 0:
                    is_all_int = 0
                    break
            if is_all_int == 1:
                ivals = []
                vm = make_mask(n_rows, 1)
                for r in range(n_rows):
                    val = _row_get_val(row_texts[r], key)
                    if val != "":
                        ivals.append(_try_parse_i64(val))
                    else:
                        ivals.append(0)
                        vm.set(r, 0)
                c2 = make_col_i64_with_mask(ivals, vm)
                result_cols.append(make_series(key, c2))
            else:
                fvals = []
                vm = make_mask(n_rows, 1)
                for r in range(n_rows):
                    val = _row_get_val(row_texts[r], key)
                    if val != "":
                        fvals.append(float(val))
                    else:
                        fvals.append(0.0)
                        vm.set(r, 0)
                c2 = make_col_f64_with_mask(fvals, vm)
                result_cols.append(make_series(key, c2))
        else:
            strs = []
            vm = make_mask(n_rows, 1)
            for r in range(n_rows):
                val = _row_get_val(row_texts[r], key)
                if val != "":
                    strs.append(val)
                else:
                    strs.append(None)
                    vm.set(r, 0)
            result_cols.append(make_series_str_with_mask(key, strs, vm))
    return make_df(result_cols)


def json_array_read_string(json_text: "str") -> "DataFrame":
    start = json_text.find("[")
    end = _json_find_matching(json_text, start, "[", "]")
    if start < 0 or end < 0:
        raise ValueError("Root element must be a JSON array.")
    sb = start + 1
    body = json_text[sb:end]
    objs = []
    n = len(body)
    i = 0
    while i < n:
        i = _json_skip_ws(body, i)
        if i < n and body[i] == "{":
            close = _json_find_matching(body, i, "{", "}")
            ce = close + 1
            seg = body[i:ce]
            objs.append(seg)
            i = close + 1
        else:
            i = i + 1
    ndjson = ""
    for li in range(len(objs)):
        if li > 0:
            ndjson = ndjson + "\n"
        ndjson = ndjson + objs[li]
    return ndjson_read_string(ndjson)


def ndjson_read_file(file_path: "str") -> "DataFrame":
    if file_exists(file_path) == 0:
        raise ValueError("File not found: " + file_path)
    return ndjson_read_string(read_file(file_path))

# ==============================================================================
# TOKENVECTOR.DATA - NUMERICS INTEROP MODULE (port tu NumericsInterop.cs)
# Bridge giua Series/DataFrame va NDArray/Tensor cua TokenVector.Numerics.
# Trong tkv, NDArray/Tensor duoc mo hinh hoa bang record Mat:
#   Mat = { rank, rows, cols, f64s: list[f64], requires_grad }
#   - ToNDArray<T>/ToTensor<T> (Series)     -> series_to_mat / series_to_mat_grad
#   - ToNDArray<T>/ToTensor<T> (DataFrame)  -> df_to_mat_2d / df_to_mat_2d_grad
#   - FromNDArray/FromTensor                -> mat_to_df / mat_to_df_from_tensor
# ==============================================================================

# NDArray 1D hoac 2D f64 (mo hinh hoa NDArray<T>/Tensor<T>)
class Mat:
    rank: "i32"
    rows: "i32"
    cols: "i32"
    f64s: "list[f64]"
    requires_grad: "i32"

def make_mat_1d(vals: "list[f64]") -> "Mat":
    n = len(vals)
    m = Mat(n, n, 1, 0)
    m.f64s = vals
    return m

def make_mat_2d(rows: "i32", cols: "i32", flat: "list[f64]") -> "Mat":
    m = Mat(2, rows, cols, 0)
    m.f64s = flat
    return m

def mat_total_length(m: "Mat") -> "i32":
    if m.rank == 1:
        n1 = len(m.f64s)
        return n1
    return m.rows * m.cols

def mat_at(m: "Mat", r: "i32", c: "i32") -> "f64":
    # 1D: chi dung r; 2D: r*cols+c (C-contiguous, giong flatData[r*colCount+c])
    if m.rank == 1:
        v1 = m.f64s[r]
        return v1
    idx = r * m.cols + c
    return m.f64s[idx]

def mat_set(m: "Mat", r: "i32", c: "i32", val: "f64") -> "i32":
    if m.rank == 1:
        m.f64s[r] = val
        return 0
    idx = r * m.cols + c
    m.f64s[idx] = val
    return 0

# ---------------- Series -> Mat (ToNDArray / ToTensor) ----------------

def series_to_mat(s: "Series") -> "Mat":
    # zero-copy khi dtype f64 va khong co null (giong C#: wrap truc tiep f64s)
    vm = s.valid
    n = vm.n
    any_null = 0
    for i in range(n):
        if vm.get(i) == 0:
            any_null = 1
            break
    if s.dtype == DT_F64 and any_null == 0:
        mz = Mat(1, n, 1, 0)
        mz.f64s = s.f64s
        return mz
    # materialize copy voi dtype conversion (null -> 0.0)
    out = []
    for i in range(n):
        if vm.get(i) == 1:
            if s.dtype == DT_F64:
                v = s.f64s[i]
                out.append(v)
            elif s.dtype == DT_I64:
                v2 = s.i64s[i]
                out.append(float(v2))
            else:
                out.append(0.0)
        else:
            out.append(0.0)
    mc = Mat(1, n, 1, 0)
    mc.f64s = out
    return mc

def series_to_mat_grad(s: "Series", requires_grad: "i32") -> "Mat":
    # ToTensor<T>(series, requiresGrad)
    m = series_to_mat(s)
    m.requires_grad = requires_grad
    return m

# ---------------- DataFrame -> Mat 2D (ToNDArray / ToTensor) ----------------

def df_to_mat_2d(df: "DataFrame") -> "Mat":
    # gom tat ca cot so (i64/f64/bool) theo thu tu cot, row-major
    nc = df.column_count()
    nr = df.row_count()
    numeric_dtypes = []
    for c in range(nc):
        s = df.col_at(c)
        if s.dtype == DT_I64 or s.dtype == DT_F64 or s.dtype == DT_BOOL:
            numeric_dtypes.append(s.dtype)
        else:
            numeric_dtypes.append(0 - 1)
    cnum = 0
    for c in range(nc):
        if numeric_dtypes[c] >= 0:
            cnum = cnum + 1
    if cnum == 0:
        me = Mat(2, 0, 0, 0)
        me.f64s = []
        return me
    flat = []
    for r in range(nr):
        for c in range(nc):
            dt = numeric_dtypes[c]
            if dt < 0:
                continue
            sc = df.col_at(c)
            if dt == DT_F64:
                v = sc.f64s[r]
                flat.append(v)
            elif dt == DT_I64:
                v2 = sc.i64s[r]
                flat.append(float(v2))
            else:
                v3 = sc.bools[r]
                flat.append(float(v3))
    m2 = Mat(2, nr, cnum, 0)
    m2.f64s = flat
    return m2

def df_to_mat_2d_grad(df: "DataFrame", requires_grad: "i32") -> "Mat":
    # ToTensor<T>(df, columns, requiresGrad)
    m = df_to_mat_2d(df)
    m.requires_grad = requires_grad
    return m

# ---------------- Mat -> DataFrame (FromNDArray / FromTensor) ----------------

def mat_to_df(m: "Mat", names: "list[str]") -> "DataFrame":
    result_cols = []
    if m.rank == 1:
        col_name = "col_0"
        if len(names) > 0:
            col_name = names[0]
        sv = []
        for i in range(len(m.f64s)):
            vv = m.f64s[i]
            sv.append(vv)
        result_cols.append(make_series_f64(col_name, sv))
        return make_df(result_cols)
    if m.rank != 2:
        return empty_df()
    for c in range(m.cols):
        col_data = []
        for r in range(m.rows):
            v = m.f64s[r * m.cols + c]
            col_data.append(v)
        cname = "col_" + str(c)
        if c < len(names):
            cname = names[c]
        result_cols.append(make_series_f64(cname, col_data))
    return make_df(result_cols)

def mat_to_df_from_tensor(m: "Mat", names: "list[str]") -> "DataFrame":
    # FromTensor<T> = FromNDArray(tensor.Data)
    return mat_to_df(m, names)

def mat_square_sum(m: "Mat") -> "Mat":
    # y = x * x (autograd forward cua test thu 3)
    n = len(m.f64s)
    out = []
    for i in range(n):
        v = m.f64s[i]
        out.append(v * v)
    mr = Mat(m.rank, m.rows, m.cols, 0)
    mr.f64s = out
    return mr



# ================== v1.5F: DataFrame -> JSON (write) ==================
def _json_escape_str(s: "str") -> "str":
    # escape JSON: backslash, quote, newline, tab, CR
    out = ""
    n = len(s)
    for i in range(n):
        ch = s[i]
        if ch == "\\":
            out = out + "\\\\"
        elif ch == "\"":
            out = out + "\\\""
        elif ch == "\n":
            out = out + "\n"
        elif ch == "\t":
            out = out + "\t"
        elif ch == "\r":
            out = out + "\r"
        else:
            out = out + ch
    return out


def json_array_write_string(df: "DataFrame") -> "str":
    # pandas df.to_json(orient="records") - [{col:val,...},...] ho tro
    # f64/i64/bool/str; null -> null. Giong nguoc lai json_array_read_string.
    nc = df.column_count()
    names = df_column_names(df)
    n = df.row_count()
    out = "["
    for r in range(n):
        if r > 0:
            out = out + ","
        out = out + "{"
        for c in range(nc):
            if c > 0:
                out = out + ","
            col = df.col_at(c)
            nm = names[c]
            if col.is_null(r) == 1:
                out = out + "\"" + _json_escape_str(nm) + "\":null"
                continue
            if col.dtype == DT_STR:
                out = out + "\"" + _json_escape_str(nm) + "\":\"" + _json_escape_str(col.get_string(r)) + "\""
            elif col.dtype == DT_I64:
                out = out + "\"" + _json_escape_str(nm) + "\":" + str(col.get_i64(r))
            elif col.dtype == DT_BOOL:
                if col.get_bool(r) == 1:
                    out = out + "\"" + _json_escape_str(nm) + "\":true"
                else:
                    out = out + "\"" + _json_escape_str(nm) + "\":false"
            else:
                out = out + "\"" + _json_escape_str(nm) + "\":" + str(col.get_f64(r))
        out = out + "}"
    out = out + "]"
    return out


def json_array_write_file(df: "DataFrame", file_path: "str") -> "i32":
    write_file(file_path, json_array_write_string(df))
    return 0

# ==============================================================================
# TOKENVECTOR.DATA - ARROW IPC / OUT-OF-CORE MODULE
# (port tu ArrowIpcEngine.cs + OutOfCoreDataFrame.cs)
# Arrow IPC stream format: magic "ARROW1" + schema + column data + footer magic.
# tkv khong co byte buffer nen luu dang JSON text; cau truc du lieu tuong duong:
#   magic | col_count | row_count | per col: name, dtype, nullable | per col:
#   mask?, dtype data, footer magic
# OutOfCoreDataFrame.Persist/Open/ReadBatch -> ooc_persist / ooc_open / ooc_read_batch
# ==============================================================================

def arrow_dtype_code(dt: "i32") -> "i32":
    # ma hoa dtype -> code byte (giong (byte)field.Type ben C#)
    return dt

def arrow_write_string(df: "DataFrame") -> "str":
    # Serializes a DataFrame into an Arrow IPC "stream" (chuoi JSON hoan doi)
    parts = []
    parts.append("ARROW1")
    nc = df.column_count()
    nr = df.row_count()
    parts.append(str(nc))
    parts.append(str(nr))
    # schema: name + dtype + nullable moi cot
    for c in range(nc):
        s = df.col_at(c)
        parts.append(s.name)
        parts.append(str(s.dtype))
        nullable = 1
        if s.dtype == DT_STR or s.dtype == DT_F64:
            parts.append(str(nullable))
        else:
            parts.append(str(nullable))
    # column data
    for c in range(nc):
        s = df.col_at(c)
        vm = s.valid
        if s.dtype == DT_STR:
            parts.append("S")
            parts.append(str(len(s.strings)))
            for i in range(len(s.strings)):
                has_null = 0
                if vm.get(i) == 0:
                    has_null = 1
                parts.append(str(has_null) + "|" + s.strings[i])
        else:
            parts.append("V")
            parts.append(str(s.dtype))
            # sentinel -1 = all-valid: bo toan bo dong mask (tia kich thuoc stream)
            if vm.all1() == 1:
                parts.append("-1")
            else:
                parts.append(str(len(vm.bits)))
                for i in range(len(vm.bits)):
                    parts.append(str(vm.bits[i]))
            if s.dtype == DT_F64:
                parts.append(str(len(s.f64s)))
                for i in range(len(s.f64s)):
                    v = s.f64s[i]
                    parts.append(str(v))
            elif s.dtype == DT_I64:
                parts.append(str(len(s.i64s)))
                for i in range(len(s.i64s)):
                    v2 = s.i64s[i]
                    parts.append(str(v2))
            elif s.dtype == DT_BOOL:
                parts.append(str(len(s.bools)))
                for i in range(len(s.bools)):
                    v4 = s.bools[i]
                    parts.append(str(v4))
    parts.append("ARROW1")
    row_text = ""
    for p in range(len(parts)):
        row_text = row_text + parts[p]
        if p < len(parts) - 1:
            row_text = row_text + "\n"
    return row_text

def arrow_read_string(stream_text: "str") -> "DataFrame":
    # Deserializes a DataFrame from an Arrow IPC "stream"
    lines = stream_text.split("\n")
    if len(lines) < 4:
        return empty_df()
    if lines[0] != "ARROW1":
        return empty_df()
    nc = int(lines[1])
    nr = int(lines[2])
    pos = 3
    names = []
    dtypes = []
    for c in range(nc):
        names.append(lines[pos])
        dtypes.append(int(lines[pos + 1]))
        pos = pos + 3
    result_cols = []
    for c in range(nc):
        dt = dtypes[c]
        vm = make_mask(nr, 1)
        if lines[pos] == "S":
            pos = pos + 1
            cnt = int(lines[pos])
            pos = pos + 1
            svals = []
            for i in range(cnt):
                cell = lines[pos]
                pos = pos + 1
                bar = cell.find("|")
                has_null = int(cell[0:bar])
                txt = cell[bar + 1:len(cell)]
                if has_null == 1:
                    vm.set(i, 0)
                    svals.append("")
                else:
                    svals.append(txt)
            result_cols.append(make_series_str_with_mask(names[c], svals, vm))
        else:
            pos = pos + 1
            col_dt = int(lines[pos])
            pos = pos + 1
            mbits = int(lines[pos])
            pos = pos + 1
            if mbits < 0:
                # sentinel all-valid: dung san mask, khong co dong bit nao
                vm.pc = nr
            else:
                for i in range(mbits):
                    bv = int(lines[pos])
                    pos = pos + 1
                    if bv == 0:
                        vm.set(i, 0)
            nvals = int(lines[pos])
            pos = pos + 1
            if col_dt == DT_F64:
                fvals = []
                for i in range(nvals):
                    fvals.append(float(lines[pos]))
                    pos = pos + 1
                result_cols.append(make_series_f64_with_mask(names[c], fvals, vm))
            elif col_dt == DT_I64:
                ivals = []
                for i in range(nvals):
                    ivals.append(int(lines[pos]))
                    pos = pos + 1
                result_cols.append(make_series_i64_with_mask(names[c], ivals, vm))
            elif col_dt == DT_BOOL:
                bvals = []
                for i in range(nvals):
                    bvals.append(int(lines[pos]))
                    pos = pos + 1
                result_cols.append(make_series_bool_with_mask(names[c], bvals, vm))
            else:
                pos = pos + nvals
                result_cols.append(make_series_f64(names[c], []))
    if lines[pos] != "ARROW1":
        return empty_df()
    return make_df(result_cols)

def arrow_write_file(df: "DataFrame", file_path: "str") -> "i32":
    write_file(file_path, arrow_write_string(df))
    return 0

def arrow_read_file(file_path: "str") -> "DataFrame":
    return arrow_read_string(read_file(file_path))

# ---------------- OutOfCoreDataFrame (persist / open / read batch) ----------------

class Ooc:
    file_path: "str"
    row_count_v: "i32"
    col_count_v: "i32"
    names: "list[str]"
    dtypes: "list[i32]"

def ooc_persist(df: "DataFrame", file_path: "str") -> "i32":
    arrow_write_file(df, file_path)
    return 0

def ooc_open(file_path: "str") -> "Ooc":
    header = arrow_read_string(read_file(file_path))
    nc = header.column_count()
    nr = header.row_count()
    nm = []
    dtl = []
    for c in range(nc):
        s = header.col_at(c)
        nm.append(s.name)
        dtl.append(s.dtype)
    o = Ooc(file_path, nr, nc)
    o.names = nm
    o.dtypes = dtl
    return o

def ooc_row_count(o: "Ooc") -> "i32":
    return o.row_count_v

def ooc_col_count(o: "Ooc") -> "i32":
    return o.col_count_v

def ooc_read_batch(o: "Ooc", offset: "i32", length: "i32") -> "DataFrame":
    # doc toan bo file, lay dong [offset, offset+length) - ung voi batch reader
    all_df = arrow_read_file(o.file_path)
    nr = all_df.row_count()
    nc = all_df.column_count()
    if offset < 0 or offset + length > nr:
        return empty_df()
    keep = []
    for i in range(length):
        keep.append(offset + i)
    picked_cols = []
    for c in range(nc):
        s = all_df.col_at(c)
        picked_cols.append(s.slice_series(offset, length))
    return make_df(picked_cols)

# ==============================================================================
# TOKENVECTOR.DATA - NUMERICS INTEROP MODULE (port tu NumericsInterop.cs)
# Bridge giua Series/DataFrame va NDArray/Tensor cua TokenVector.Numerics.
# Trong tkv, NDArray/Tensor duoc mo hinh hoa bang record Mat:
#   Mat = { rank, rows, cols, f64s: list[f64], requires_grad }
#   - ToNDArray<T>/ToTensor<T> (Series)     -> series_to_mat / series_to_mat_grad
#   - ToNDArray<T>/ToTensor<T> (DataFrame)  -> df_to_mat_2d / df_to_mat_2d_grad
#   - FromNDArray/FromTensor                -> mat_to_df / mat_to_df_from_tensor
# ==============================================================================

# NDArray 1D hoac 2D f64 (mo hinh hoa NDArray<T>/Tensor<T>)

def run() -> "str":
    return "LIBOK"


# ==================== v1.6: read_csv flags (csv_read_ex) ====================
# --------------------- read_csv flags (pandas parity) ------------------------
# csv_read_ex(text, sep, header, names, dtype, na_values, skiprows)
# - header: 0 = khong co dong header, 1 = co dong header (mac dinh)
# - names:  list ten cot; khac rong -> override header (header duoc bo qua,
#           giong pandas khi truyen names) hoac dat ten khi header=0
# - dtype:  list dtype theo THU TU cot ("", "i64", "f64", "str") - khac rong
#           bo qua infer; cot nho hon list -> infer; dai hon -> DT_STR
# - na_values: list chuoi coi la null (them vao "" va null_value mac dinh)
# - skiprows: bo N dong dau text (tren toan bo text, giong pandas skiprows=N)
# Tra ve DataFrame voi null-mask dung cho o rong / o == na_values.
def csv_read_ex(csv_text: "str", delimiter: "str", has_header: "i32", null_value: "str", names: "list[str]", dtypes_spec: "list[str]", na_values: "list[str]", skiprows: "i32") -> "DataFrame":
    if csv_text == "":
        return empty_df()
    if skiprows > 0:
        all_lines = csv_text.split("\n")
        if skiprows >= len(all_lines):
            return empty_df()
        kept = []
        for i in range(skiprows, len(all_lines)):
            kept.append(all_lines[i])
        csv_text = kept[0]
        for i in range(1, len(kept)):
            csv_text = csv_text + "\n" + kept[i]
    lines = csv_text.split("\n")
    n_lines = len(lines)
    column_names = []
    data_start = 0
    use_names = 0
    if names != None:
        if len(names) > 0:
            use_names = 1
    if use_names == 0:
        if has_header == 1:
            header_line = lines[0]
            hl = len(header_line)
            if hl > 0 and header_line[hl - 1] == "\r":
                header_line = header_line[0:hl - 1]
            header_fields = _split_csv_line(header_line, delimiter, "\"")
            for f in range(len(header_fields)):
                column_names.append(header_fields[f])
            data_start = 1
        else:
            if n_lines > 0:
                first_line = lines[0]
                fl = len(first_line)
                if fl > 0 and first_line[fl - 1] == "\r":
                    first_line = first_line[0:fl - 1]
                first_fields = _split_csv_line(first_line, delimiter, "\"")
                n_first = len(first_fields)
                for i in range(n_first):
                    column_names.append("column_" + str(i))
            else:
                column_names.append("column_0")
    else:
        # names override: header=1 -> bo qua dong header; header=0 -> data tu dong 0
        for i in range(len(names)):
            column_names.append(names[i])
        if has_header == 1:
            data_start = 1
    n_cols = len(column_names)
    n_spec = 0
    if dtypes_spec != None:
        n_spec = len(dtypes_spec)
    n_na = 0
    if na_values != None:
        n_na = len(na_values)
    if data_start >= n_lines:
        result_cols = []
        for c in range(n_cols):
            result_cols.append(make_series_str(column_names[c], []))
        return make_df(result_cols)
    grid = []
    total_data = 0
    for i in range(data_start, n_lines):
        line = lines[i]
        ln = len(line)
        if ln > 0 and line[ln - 1] == "\r":
            line = line[0:ln - 1]
        if line == "" and i == n_lines - 1:
            break
        if line.find("\"") == 0 - 1:
            fields = line.split(delimiter)
        else:
            fields = _split_csv_line(line, delimiter, "\"")
        nf = len(fields)
        for c in range(n_cols):
            if c < nf:
                grid.append(fields[c])
            else:
                grid.append("")
        total_data = total_data + 1
    if total_data == 0:
        result_cols = []
        for c in range(n_cols):
            result_cols.append(make_series_str(column_names[c], []))
        return make_df(result_cols)
    result_cols = []
    for c in range(n_cols):
        col_name = column_names[c]
        # resolve dtype: spec roi roi -> infer
        dt = 0 - 1
        if c < n_spec:
            spec = dtypes_spec[c]
            if spec == "i64":
                dt = DT_I64
            elif spec == "f64":
                dt = DT_F64
            elif spec == "str":
                dt = DT_STR
        if dt == 0 - 1:
            sub = _csv_grid_subcol(grid, c, n_cols, total_data)
            dt = _infer_dtypes_grid(sub, 1, total_data, null_value)[0]
        if dt == DT_I64:
            ivals = []
            vm = make_mask(total_data, 1)
            for i in range(total_data):
                raw = grid[i * n_cols + c].strip()
                if _csv_is_null(raw, null_value, na_values, n_na):
                    ivals.append(0)
                    vm.set(i, 0)
                else:
                    ivals.append(int(raw))
            result_cols.append(make_series(col_name, make_col_i64_with_mask(ivals, vm)))
        elif dt == DT_F64:
            fvals = []
            vm = make_mask(total_data, 1)
            for i in range(total_data):
                raw = grid[i * n_cols + c].strip()
                if _csv_is_null(raw, null_value, na_values, n_na):
                    fvals.append(0.0)
                    vm.set(i, 0)
                else:
                    fvals.append(float(raw))
            result_cols.append(make_series(col_name, make_col_f64_with_mask(fvals, vm)))
        elif dt == DT_BOOL:
            bvals = []
            vm = make_mask(total_data, 1)
            for i in range(total_data):
                raw = grid[i * n_cols + c].strip().lower()
                if _csv_is_null(raw, null_value, na_values, n_na):
                    bvals.append(0)
                    vm.set(i, 0)
                elif raw == "true":
                    bvals.append(1)
                elif raw == "false":
                    bvals.append(0)
                else:
                    bvals.append(0)
                    vm.set(i, 0)
            result_cols.append(make_series(col_name, make_col_bool_with_mask(bvals, vm)))
        else:
            strs = []
            vm = make_mask(total_data, 1)
            for i in range(total_data):
                val = grid[i * n_cols + c]
                if _csv_is_null(val.strip(), null_value, na_values, n_na):
                    strs.append("")
                    vm.set(i, 0)
                else:
                    strs.append(val)
            result_cols.append(make_series_str_with_mask(col_name, strs, vm))
    return make_df(result_cols)


def _csv_grid_subcol(grid: "list[str]", c: "i32", n_cols: "i32", total_data: "i32") -> "list[str]":
    sub = []
    for i in range(total_data):
        sub.append(grid[i * n_cols + c])
    return sub


def _csv_is_null(raw: "str", null_value: "str", na_values: "list[str]", n_na: "i32") -> "i32":
    if raw == "":
        return 1
    if raw == null_value:
        return 1
    for i in range(n_na):
        if raw == na_values[i]:
            return 1
    return 0


def csv_read_file_ex(file_path: "str", delimiter: "str", has_header: "i32", null_value: "str", names: "list[str]", dtypes_spec: "list[str]", na_values: "list[str]", skiprows: "i32") -> "DataFrame":
    if file_exists(file_path) == 0:
        raise ValueError("File not found: " + file_path)
    text = read_file(file_path)
    return csv_read_ex(text, delimiter, has_header, null_value, names, dtypes_spec, na_values, skiprows)
