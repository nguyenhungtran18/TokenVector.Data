# -*- coding: utf-8 -*-
__tkv_import__ = ["tokenvector_data", "tokenvector_io", "tokenvector_datetime", "tokenvector_excel", "tokenvector_parquet"]

fails: "i32" = 0

def chk(cond: "i32", label: "str") -> "i32":
    global fails
    if cond == 1:
        print("PASS", label)
    else:
        print("FAIL", label)
        fails = fails + 1
    return 0


def _mk() -> "DataFrame":
    ids = make_series_i64("id", [101, 102, 103])
    cities = make_series_str("city", ["New York", "San Francisco, CA", "London"])
    temps = make_series_f64("temp", [22.4, 18.2, 15.0])
    return make_df([ids, cities, temps])


def main() -> "i32":
    global fails
    df = _mk()
    # X1: write string co khung SpreadsheetML + escape
    x1 = excel_write_string(df, "Sheet1")
    chk(x1.find("<Workbook") >= 0, "x1 workbook tag")
    chk(x1.find("<Worksheet") >= 0, "x1 worksheet tag")
    chk(x1.find("ss:Type=\"Number\"") >= 0, "x1 number type")
    chk(x1.find("ss:Type=\"String\"") >= 0, "x1 string type")
    chk(x1.find("San Francisco, CA") >= 0, "x1 comma kept")
    de = make_df([make_series_str("e", ["a&b", "x<y>", "q\"q", "o'b"])])
    xe = excel_write_string(de, "S")
    chk(xe.find("a&amp;b") >= 0, "x1 amp escape")
    chk(xe.find("x&lt;y&gt;") >= 0, "x1 angle escape")
    chk(xe.find("q&quot;q") >= 0, "x1 quot escape")
    # X2: round-trip memory (types + values)
    back = excel_read_string(x1)
    chk(back.row_count() == 3, "x2 rows")
    chk(back.column_count() == 3, "x2 cols")
    chk(back.col_by_name("id").get_i64(1) == 102, "x2 i64 val")
    chk(back.col_by_name("city").get_string(1) == "San Francisco, CA", "x2 str val")
    chk(back.col_by_name("temp").get_f64(0) > 22.39, "x2 f64 lo")
    chk(back.col_by_name("temp").get_f64(0) < 22.41, "x2 f64 hi")
    cid = back.col_by_name("id")
    chk(cid.dtype == DT_I64, "x2 i64 dtype")
    ctp = back.col_by_name("temp")
    chk(ctp.dtype == DT_F64, "x2 f64 dtype")
    backe = excel_read_string(xe)
    chk(backe.row_count() == 4, "x2b esc rows")
    chk(backe.col_by_name("e").get_string(0) == "a&b", "x2b amp back")
    chk(backe.col_by_name("e").get_string(1) == "x<y>", "x2b angle back")
    chk(backe.col_by_name("e").get_string(2) == "q\"q", "x2b quot back")
    chk(backe.col_by_name("e").get_string(3) == "o'b", "x2b apos back")
    # X3: null + bool round-trip
    ids3 = [1, 2, 3]
    fl = make_series_i64("id", ids3)
    sv = ["a", "", "c"]
    vm = make_mask(3, 1)
    vm.set(1, 0)
    st = make_series_str_with_mask("s", sv, vm)
    bv = [1, 0, 1]
    bo = make_series("b", make_col_bool(bv))
    df3 = make_df([fl, st, bo])
    back3 = excel_read_string(excel_write_string(df3, "N"))
    chk(back3.col_by_name("s").is_null(1) == 1, "x3 null kept")
    chk(back3.col_by_name("s").get_string(2) == "c", "x3 str after null")
    cb = back3.col_by_name("b")
    chk(cb.dtype == DT_BOOL, "x3 bool dtype")
    chk(back3.col_by_name("b").get_bool(0) == 1, "x3 bool val")
    chk(back3.col_by_name("b").get_bool(1) == 0, "x3 bool val0")
    # X4: file round-trip
    excel_write_file(df, "_xl_check.xml", "Data")
    fback = excel_read_file("_xl_check.xml")
    chk(fback.row_count() == 3, "x4 file rows")
    chk(fback.col_by_name("city").get_string(2) == "London", "x4 file val")
    # X5: header-only (0 data rows) -> ten cot giu nguyen
    hdf = make_df([make_series_str("a", []), make_series_i64("b", [])])
    hback = excel_read_string(excel_write_string(hdf, "H"))
    chk(hback.column_count() == 2, "x5 header cols")
    chk(hback.row_count() == 0, "x5 header rows")
    ha = hback.col_by_name("a")
    chk(ha.name == "a", "x5 header name")
    # X6: parquet ledger trung thuc (stub chan + ly do)
    rs = parquet_blocked_reason()
    chk(rs.find("blocked-by-compiler") >= 0, "x6 parquet ledger")
    chk(rs.find("binary write") >= 0, "x6 parquet cause")
    print("FAILS=", fails)
    return 0
