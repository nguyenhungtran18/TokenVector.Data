# -*- coding: utf-8 -*-
__tkv_import__ = ["tokenvector_data", "tokenvector_io"]

def _ms(t1, t2) -> "f64":
    d = t2 - t1
    ticks = datetime_ticks(d)
    return float(ticks) / 10000.0


def main() -> "i32":
    fails = 0
    # 1: i64 + null
    t = "id,score\n1,10\n2,\n3,30\n"
    df = csv_read_string(t, ",", 1, "")
    dts = df_schema_dtypes(df)
    print("t1 dtypes=" + str(dts[0]) + "," + str(dts[1]) + " rows=" + str(df.row_count()))
    c1 = df.col_by_name("id")
    c2 = df.col_by_name("score")
    if dts[0] != 4 or dts[1] != 4:
        fails = fails + 1
        print("FAIL t1 dtype")
    if c1.get_i64(2) != 3 or c2.is_null(1) != 1 or c2.get_i64(2) != 30:
        fails = fails + 1
        print("FAIL t1 values")
    # 2: float + quoted str voi delimiter ben trong
    tx2 = "name,price,note\n\"alpha, inc\",1.5,ok\nbeta,,\"say \"\"hi\"\"\"\n"
    df2 = csv_read_string(tx2, ",", 1, "")
    dts2 = df_schema_dtypes(df2)
    print("t2 dtypes=" + str(dts2[0]) + "," + str(dts2[1]) + "," + str(dts2[2]))
    cn = df2.col_by_name("name")
    cp = df2.col_by_name("price")
    if dts2[1] != 10 or cn.get_string(0) != "alpha, inc" or cp.is_null(1) != 1:
        fails = fails + 1
        print("FAIL t2 values name0=" + cn.get_string(0))
    # 3: bool
    t3 = "flag,n\ntrue,1\nfalse,2\n"
    df3 = csv_read_string(t3, ",", 1, "")
    dts3 = df_schema_dtypes(df3)
    print("t3 dtypes=" + str(dts3[0]) + "," + str(dts3[1]))
    if dts3[0] != 11:
        fails = fails + 1
        print("FAIL t3 bool dtype")
    # 4: khong header + CRLF
    t4 = "a,b\r\n1,2\r\n3,4\r\n"
    df4 = csv_read_string(t4, ",", 0, "")
    print("t4 rows=" + str(df4.row_count()) + " cols=" + str(df4.column_count()))
    if df4.row_count() != 3 or df4.column_count() != 2:
        fails = fails + 1
        print("FAIL t4 shape")
    # 5: perf 100k rows (giong B5 bench: id i64, g str, val f64)
    N = 100000
    parts = []
    for i in range(N):
        g = "A"
        if i % 3 == 1:
            g = "B"
        elif i % 3 == 2:
            g = "C"
        parts.append(str(i) + "," + g + "," + str(i * 2) + ".5")
    body = parts[0]
    for k in range(1, len(parts)):
        body = body + "\n" + parts[k]
    csvtext = "id,g,val\n" + body + "\n"
    t1 = datetime()
    df5 = csv_read_string(csvtext, ",", 1, "")
    t2 = datetime()
    print("t5 perf rows=" + str(df5.row_count()) + " ms=" + str(_ms(t1, t2)))
    # t6: read_csv flags (dtype/na_values/names/sep/skiprows) - pandas parity
    # df goc co "Smith, John" (chua dau phay) -> ghi file -> doc lai voi flag
    ss1 = []
    ss2 = []
    ss2.append("Smith, John")
    ss2.append("said \"hi\"")
    ss2.append("")
    ss2.append("Bo")
    ss1.append("Smith, John")
    ss1.append("Ann")
    ss1.append(None)
    ss1.append("Bo")
    colA = make_series_str("name", ss1)
    colB = make_series_str("note", ss2)
    vmc = make_mask(4, 1)
    vmc.set(2, 0)
    vmc.set(3, 0)
    colC = make_series_f64_with_mask("score", [3.5, 7.0, 0.0, 0.0], vmc)
    vm = make_mask(4, 1)
    vm.set(1, 0)
    colD = make_series_bool_with_mask("ok", [1, 0, 0, 1], vm)
    cols = []
    cols.append(colA)
    cols.append(colB)
    cols.append(colC)
    cols.append(colD)
    dfx = make_df(cols)
    csv_write_file(dfx, "_rt6.csv", ",", 1, "")
    # baseline: doc lai - quote, null, f64, bool phai dung
    dfa = csv_read_file_ex("_rt6.csv", ",", 1, "", [], [], [], 0)
    if dfa.col_at(0).get_string(0) != "Smith, John" or dfa.col_at(1).is_null(2) != 1 or dfa.col_at(2).get_f64(0) != 3.5 or dfa.col_at(3).get_bool(0) != 1:
        fails = fails + 1
        print("t6 FAIL baseline quote/empty/bool")
    if dfa.col_at(2).is_null(2) != 1 or dfa.col_at(2).is_null(3) != 1:
        fails = fails + 1
        print("t6 FAIL empty-f64-null")
    # na_values: ghi null_value="NA" roi doc voi na_values=["NA"]
    csv_write_file(dfx, "_rt6na.csv", ",", 1, "NA")
    dfb = csv_read_file_ex("_rt6na.csv", ",", 1, "", [], [], ["NA"], 0)
    if dfb.col_at(1).is_null(2) != 1 or dfb.col_at(0).is_null(2) != 1:
        fails = fails + 1
        print("t6 FAIL na_values")
    # dtype override: doc score/ok lam str, va f64 cho cot cu the
    dfc = csv_read_file_ex("_rt6.csv", ",", 1, "", [], ["str", "str", "str", "str"], [], 0)
    if dfc.col_at(2).get_string(0) != "3.5" or dfc.col_at(3).get_string(0).find("rue") < 0:
        fails = fails + 1
        print("t6 FAIL dtype str")
    dfc2 = csv_read_file_ex("_rt6.csv", ",", 1, "", [], ["", "", "f64", ""], [], 0)
    if dfc2.col_at(2).get_f64(0) != 3.5:
        fails = fails + 1
        print("t6 FAIL dtype f64")
    # names override (header=1 -> bo qua dong header)
    dfd = csv_read_file_ex("_rt6.csv", ",", 1, "", ["who", "memo", "val", "flag"], [], [], 0)
    if df_column_names(dfd)[0] != "who" or dfd.col_at(0).get_string(0) != "Smith, John":
        fails = fails + 1
        print("t6 FAIL names override")
    # names + sep (header=0)
    headless = "1;x\n2;y\n"
    dfe = csv_read_ex(headless, ";", 0, "", ["id", "tag"], [], [], 0)
    if dfe.row_count() != 2 or dfe.col_at(0).get_i64(1) != 2 or dfe.col_at(1).get_string(1) != "y":
        fails = fails + 1
        print("t6 FAIL names+sep")
    # skiprows: "junk line" + header + 2 dong
    t4 = "junk line\nname,score\nA,1\nB,2\n"
    dff = csv_read_ex(t4, ",", 1, "", [], [], [], 1)
    if df_column_names(dff)[0] != "name" or dff.row_count() != 2 or dff.col_at(1).get_i64(1) != 2:
        fails = fails + 1
        print("t6 FAIL skiprows")
    if csv_read_ex("a,b\n1,2\n", ",", 1, "", [], [], [], 99).row_count() != 0:
        fails = fails + 1
        print("t6 FAIL skipall")
    if fails == 0:
        print("t6 csv flags OK")
    # t7: chunked read (pandas chunksize) - chia theo DATA rows, header chunk dau
    # CSV 2000 dong id,val: chunksize=300 -> 7 t7_chunks (300*6=1800, cuoi 200)
    t7_NL = "\n"
    t7_parts = []
    t7_p = 0
    while t7_p < 2000:
        t7_parts.append(str(t7_p) + "," + str(float(t7_p) * 0.25))
        t7_p = t7_p + 1
    t7_body2000 = "id,val"
    t7_p = 0
    while t7_p < len(t7_parts):
        t7_body2000 = t7_body2000 + "\n" + t7_parts[t7_p]
        t7_p = t7_p + 1
    t7_body2000 = t7_body2000 + "\n"
    t7_chunks = csv_read_chunks(t7_body2000, ",", 1, "", [], [], [], 0, 300)
    if len(t7_chunks) != 7:
        fails = fails + 1
        print("t7 FAIL nchunks=" + str(len(t7_chunks)))
    t7_total7 = 0
    t7_zi = 0
    while t7_zi < len(t7_chunks):
        t7_czj = t7_chunks[t7_zi]
        t7_total7 = t7_total7 + t7_czj.row_count()
        t7_zi = t7_zi + 1
    if t7_total7 != 2000:
        fails = fails + 1
        print("t7 FAIL total=" + str(t7_total7))
    # khong trung/thieu + bien gioi: chunk k bat dau tai id k*300
    t7_marks = []
    t7_mi = 0
    while t7_mi < 2000:
        t7_marks.append(0)
        t7_mi = t7_mi + 1
    t7_zi = 0
    while t7_zi < len(t7_chunks):
        t7_czj = t7_chunks[t7_zi]
        t7_cjcol = t7_czj.col_at(0)
        t7_cjval = t7_czj.col_at(1)
        if t7_czj.row_count() > 0 and t7_cjcol.get_i64(0) != t7_zi * 300:
            fails = fails + 1
            print("t7 FAIL boundary chunk " + str(t7_zi))
        t7_rj = 0
        while t7_rj < t7_czj.row_count():
            t7_vid = t7_cjcol.get_i64(t7_rj)
            if t7_vid < 0 or t7_vid >= 2000:
                fails = fails + 1
                print("t7 FAIL range " + str(t7_vid))
            elif t7_marks[t7_vid] == 1:
                fails = fails + 1
                print("t7 FAIL dup " + str(t7_vid))
            else:
                t7_marks[t7_vid] = 1
            if t7_cjval.get_f64(t7_rj) != float(t7_vid) * 0.25:
                fails = fails + 1
                print("t7 FAIL val " + str(t7_vid))
            t7_rj = t7_rj + 1
        t7_zi = t7_zi + 1
    t7_mi = 0
    while t7_mi < 2000:
        if t7_marks[t7_mi] == 0:
            fails = fails + 1
            print("t7 FAIL missing " + str(t7_mi))
        t7_mi = t7_mi + 1
    # nho hon 1 chunk -> 1 chunk; skiprows ap dung 1 lan truoc khi chia
    t7_tiny = csv_read_chunks("a,b" + t7_NL + "1,2" + t7_NL, ",", 1, "", [], [], [], 0, 100)
    if len(t7_tiny) != 1 or t7_tiny[0].row_count() != 1:
        fails = fails + 1
        print("t7 FAIL small")
    t7_c4 = csv_read_chunks("junk" + t7_NL + "x,y" + t7_NL + "5,6" + t7_NL + "7,8" + t7_NL, ",", 1, "", [], [], [], 1, 1)
    if len(t7_c4) != 2 or t7_c4[0].row_count() != 1 or t7_c4[1].row_count() != 1:
        fails = fails + 1
        print("t7 FAIL skiprows")
    t7_c4x = t7_c4[0].col_at(0)
    t7_c4y = t7_c4[1].col_at(1)
    if t7_c4x.get_i64(0) != 5 or t7_c4y.get_i64(0) != 8:
        fails = fails + 1
        print("t7 FAIL skipvals")
    # flags co dinh qua chunk: val infer f64, NA -> null ca 2 chunk
    t7_c5 = csv_read_chunks("id,v" + t7_NL + "1,2.5" + t7_NL + "2,NA" + t7_NL + "3,4.0" + t7_NL + "4,NA" + t7_NL, ",", 1, "", [], [], ["NA"], 0, 2)
    if len(t7_c5) != 2:
        fails = fails + 1
        print("t7 FAIL flag-n")
    t7_d0 = t7_c5[0].col_at(1)
    t7_d1 = t7_c5[1].col_at(1)
    if t7_d0.get_f64(0) != 2.5 or t7_d0.is_null(1) != 1 or t7_d1.is_null(1) != 1:
        fails = fails + 1
        print("t7 FAIL flag-null")
    if fails == 0:
        print("t7 chunked read OK")
    # t8: streaming csv_read_chunks_file - file that 2000 dong, chunk 500 -> 4
    t8_parts = []
    t8_i = 0
    while t8_i < 2000:
        t8_parts.append(str(t8_i) + "," + str(float(t8_i) * 0.5))
        t8_i = t8_i + 1
    t8_body = "id,val"
    t8_k = 0
    while t8_k < len(t8_parts):
        t8_body = t8_body + "\n" + t8_parts[t8_k]
        t8_k = t8_k + 1
    t8_body = t8_body + "\n"
    write_file("_t8stream.csv", t8_body)
    t8_ch = csv_read_chunks_file("_t8stream.csv", ",", 1, "", [], [], [], 0, 500)
    if len(t8_ch) != 4:
        fails = fails + 1
        print("t8 FAIL nchunks=" + str(len(t8_ch)))
    t8_tot = 0
    t8_z = 0
    while t8_z < len(t8_ch):
        t8_c = t8_ch[t8_z]
        t8_tot = t8_tot + t8_c.row_count()
        t8_c0 = t8_c.col_at(0)
        if t8_c0.get_i64(0) != t8_z * 500:
            fails = fails + 1
            print("t8 FAIL boundary " + str(t8_z))
        t8_z = t8_z + 1
    if t8_tot != 2000:
        fails = fails + 1
        print("t8 FAIL total=" + str(t8_tot))
    t8_last = t8_ch[3]
    t8_v = t8_last.col_at(1)
    t8_n = t8_last.row_count()
    if t8_v.get_f64(t8_n - 1) != 999.5:
        fails = fails + 1
        print("t8 FAIL val")
    if fails == 0:
        print("t8 stream chunks OK")
    if fails == 0:
        print("ALL CSV TESTS PASS")
    else:
        print("FAILS=" + str(fails))
    return 0

