# -*- coding: utf-8 -*-
__tkv_import__ = ["tokenvector_data", "tokenvector_io", "tokenvector_datetime"]

fails: "i32" = 0

def chk(cond: "i32", label: "str") -> "i32":
    global fails
    if cond == 1:
        print("PASS", label)
    else:
        print("FAIL", label)
        fails = fails + 1
    return 0

def main() -> "i32":
    global fails
    # t1: parse_dates trong csv_read_ex: str -> i64 epoch ms, giu ten cot
    csvx = "id,when" + "\n" + "1,2024-03-15T10:30:00" + "\n" + "2,2024-03-16T11:00:00" + "\n"
    df = csv_read_ex(csvx, ",", 1, "", [], [], [], 0, ["when"])
    w = df.col_by_name("when")
    chk(w.dtype == DT_I64, "t1 dtype i64")
    chk(w.name == "when", "t1 giu ten cot")
    chk(w.get_i64(0) == dt_parse("2024-03-15T10:30:00"), "t1 epoch dung")
    chk(w.get_i64(1) > w.get_i64(0), "t1 tang dan")
    # khong parse: cot van str
    df0 = csv_read_ex(csvx, ",", 1, "", [], [], [], 0, [])
    w0 = df0.col_by_name("when")
    chk(w0.dtype == DT_STR, "t1b khong parse giu str")

    # t2: parse_dates trong csv_read_chunks (chunksize=1)
    chs = csv_read_chunks(csvx, ",", 1, "", [], [], [], 0, 1, ["when"])
    chk(len(chs) == 2, "t2 so chunk")
    c0 = chs[0].col_by_name("when")
    chk(c0.dtype == DT_I64, "t2 chunk dtype i64")

    # t3: csv_read_chunks_file (file that) co parse_dates
    write_file("_pd_t3.csv", csvx)
    chs2 = csv_read_chunks_file("_pd_t3.csv", ",", 1, "", [], [], [], 0, 2, ["when"])
    c2 = chs2[0].col_by_name("when")
    chk(c2.dtype == DT_I64, "t3 file chunk dtype i64")

    # t4: encoding utf-8 (file KHONG BOM - TKV write_file double-encode U+FEFF
    # nen khong tao duoc BOM that tu string; strip BOM that da xac minh o tang
    # open cua runtime). parse_dates chay duoc qua duong _enc.
    write_file("_pd_t4.csv", csvx)
    chs4 = csv_read_chunks_file_enc("_pd_t4.csv", ",", 1, "", [], [], [], 0, 1, "utf-8", ["when"])
    chk(len(chs4) == 2, "t4 so chunk")
    w4 = chs4[0].col_by_name("when")
    chk(w4.dtype == DT_I64, "t4 dtype i64")
    chk(chs4[0].row_count() == 1, "t4 1 row/chunk")

    # t5: nhanh latin-1 (byte-per-char). Luu y: TKV write_file double-encode
    # ky tu >127 (cung nhu BOM) nen khong tao duoc fixture non-ASCII tu string
    # literal; doc byte >127 qua latin-1 = 1 ky tu da xac minh o tang runtime.
    write_file("_pd_t5.csv", "id,name" + "\n" + "1,an" + "\n" + "2,binh" + "\n")
    chs5 = csv_read_chunks_file_enc("_pd_t5.csv", ",", 1, "", [], [], [], 0, 10, "latin-1", [])
    nm = chs5[0].col_by_name("name")
    chk(nm.get_string(1) == "binh", "t5 latin-1 doc dung")
    chk(chs5[0].row_count() == 2, "t5 so row")

    # t6: encoding "" = mac dinh (stream default)
    chs6 = csv_read_chunks_file_enc("_pd_t3.csv", ",", 1, "", [], [], [], 0, 10, "", [])
    chk(chs6[0].row_count() == 2, "t6 default encoding")

    # t7: parse_dates cot khong ton tai -> khong loi, khong doi
    df7 = csv_read_ex(csvx, ",", 1, "", [], [], [], 0, ["missing"])
    w7 = df7.col_by_name("when")
    chk(w7.dtype == DT_STR, "t7 cot le num")

    print("FAILS=", fails)
    return 0
