# -*- coding: utf-8 -*-
# =============================================================================
# TokenVector.Data - Module JSON native (v1.7)
# Doc/ghi JSON array-of-objects giong pandas read_json/to_json (orient=records):
#   - json_read_string/file: chuan hoa dtype per-column (bool > i64 > f64 > str;
#     sai loai o mot dong -> null dong do, giong pandas coerse)
#   - json_read_records: dtype_spec - ep cot time -> i64 epoch ms (dt_parse)
#   - json_write_string/file: orient=records (i64/bool/f64/str/null dung kieu)
#   - jsonl_read_string/file: JSON Lines (moi dong 1 object)
# Parser tu viet (tokenizer + recursive descent); dung constants/make_* cua
# tokenvector_data (import thong minh trong merged).
# =============================================================================
__tkv_import__ = ["tokenvector_data", "tokenvector_datetime"]

class _JTok:
    kind: "i32"   # 1 obj / 2 arr / 3 num / 4 str / 5 bool / 6 null
    f: "f64"
    b: "i32"
    s: "str"
    end: "i32"
    items: "list[_JTok]"
    keys: "list[str]"


def _jt_new(kind: "i32") -> "_JTok":
    t = _JTok(kind, 0.0, 0, "", 0)
    t.items = []
    t.keys = []
    return t


def _jt_str_raw(s: "str") -> "str":
    # bo escape JSON: \\ \/ \" \n \t \r \uXXXX
    out = ""
    i = 0
    n = len(s)
    while i < n:
        c = s[i]
        if c == "\\" and i + 1 < n:
            c2 = s[i + 1]
            if c2 == "n":
                out = out + "\n"
                i = i + 2
            elif c2 == "t":
                out = out + "\t"
                i = i + 2
            elif c2 == "r":
                out = out + "\r"
                i = i + 2
            elif c2 == "\"":
                out = out + "\""
                i = i + 2
            elif c2 == "\\":
                out = out + "\\"
                i = i + 2
            elif c2 == "/":
                out = out + "/"
                i = i + 2
            elif c2 == "u" and i + 5 < n:
                # uXXXX escape: bo qua (chua co chr() builtin - xem gap R9
                # compiler; hang hoa nhu io._json_parse_string)
                i = i + 4
            else:
                out = out + c2
                i = i + 2
        else:
            out = out + c
            i = i + 1
    return out


def _jt_hex_digit(ch: "str") -> "i32":
    # tra ve 0..15, hoac -1 neu khong phai hex digit (thay cho ord(ch))
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    if ch == "9":
        return 9
    if ch == "a" or ch == "A":
        return 10
    if ch == "b" or ch == "B":
        return 11
    if ch == "c" or ch == "C":
        return 12
    if ch == "d" or ch == "D":
        return 13
    if ch == "e" or ch == "E":
        return 14
    if ch == "f" or ch == "F":
        return 15
    return -1


def _jt_hex4(s: "str") -> "i32":
    d0 = _jt_hex_digit(s[0])
    d1 = _jt_hex_digit(s[1])
    d2 = _jt_hex_digit(s[2])
    d3 = _jt_hex_digit(s[3])
    if d0 < 0 or d1 < 0 or d2 < 0 or d3 < 0:
        return -1
    return d0 * 4096 + d1 * 256 + d2 * 16 + d3


def _jt_skip_ws(s: "str", i: "i32") -> "i32":
    n = len(s)
    while i < n:
        c = s[i]
        if c == " " or c == "\t" or c == "\n" or c == "\r":
            i = i + 1
        else:
            break
    return i


def _jt_parse(s: "str", pos: "i32") -> "_JTok":
    i = _jt_skip_ws(s, pos)
    n = len(s)
    if i >= n:
        raise ValueError("json: het chuoi khi con dang parse")
    c = s[i]
    if c == "{":
        t = _jt_new(1)
        i = i + 1
        i = _jt_skip_ws(s, i)
        if i < n and s[i] == "}":
            t.end = i + 1
            return t
        more = 1
        while more == 1:
            i = _jt_skip_ws(s, i)
            if i >= n or s[i] != "\"":
                raise ValueError("json: doi key string")
            j = i + 1
            while j < n:
                if s[j] == "\\":
                    j = j + 2
                    continue
                if s[j] == "\"":
                    break
                j = j + 1
            key = _jt_str_raw(s[i + 1:j])
            i = _jt_skip_ws(s, j + 1)
            if i >= n or s[i] != ":":
                raise ValueError("json: doi ':'")
            v = _jt_parse(s, i + 1)
            t.keys.append(key)
            t.items.append(v)
            i = _jt_skip_ws(s, v.end)
            if i < n and s[i] == ",":
                i = i + 1
                continue
            if i < n and s[i] == "}":
                i = i + 1
                t.end = i
                more = 0
            else:
                raise ValueError("json: doi ',' hoac '}' trong object")
        return t
    if c == "[":
        t = _jt_new(2)
        i = i + 1
        i = _jt_skip_ws(s, i)
        if i < n and s[i] == "]":
            t.end = i + 1
            return t
        more = 1
        while more == 1:
            v = _jt_parse(s, i)
            t.items.append(v)
            i = _jt_skip_ws(s, v.end)
            if i < n and s[i] == ",":
                i = i + 1
                continue
            if i < n and s[i] == "]":
                i = i + 1
                t.end = i
                more = 0
            else:
                raise ValueError("json: doi ',' hoac ']' trong array")
        return t
    if c == "\"":
        j = i + 1
        while j < n:
            if s[j] == "\\":
                j = j + 2
                continue
            if s[j] == "\"":
                break
            j = j + 1
        t = _jt_new(4)
        t.s = _jt_str_raw(s[i + 1:j])
        t.end = j + 1
        return t
    if i + 4 <= n and s[i:i + 4] == "true":
        t = _jt_new(5)
        t.b = 1
        t.end = i + 4
        return t
    if i + 5 <= n and s[i:i + 5] == "false":
        t = _jt_new(5)
        t.end = i + 5
        return t
    if i + 4 <= n and s[i:i + 4] == "null":
        t = _jt_new(6)
        t.end = i + 4
        return t
    # number
    j = i
    while j < n:
        cj = s[j]
        if (cj >= "0" and cj <= "9") or cj == "-" or cj == "+" or cj == "." or cj == "e" or cj == "E":
            j = j + 1
        else:
            break
    if j == i:
        raise ValueError("json: ky tu khong hop le '" + c + "'")
    t = _jt_new(3)
    t.f = float(s[i:j])
    t.s = s[i:j]
    t.end = j
    return t


def _jt_obj_get(o: "_JTok", key: "str") -> "_JTok":
    # khong tim thay -> token kind 0 (sentinel; tao moi de tranh hang so
    # module-level goi ham - compiler khong cho phep)
    for k in range(len(o.keys)):
        if o.keys[k] == key:
            return o.items[k]
    return _jt_new(0)


# === SECTION 2: read (orient=records) =========================================

def json_read_string(json_text: "str") -> "DataFrame":
    root = _jt_parse(json_text, 0)
    if root.kind != 2:
        raise ValueError("json_read_string: root phai la JSON array")
    n_obj = len(root.items)
    if n_obj == 0:
        return empty_df()
    keys = []
    for oi in range(n_obj):
        o = root.items[oi]
        if o.kind != 1:
            continue
        for k in range(len(o.keys)):
            kn = o.keys[k]
            if kn in keys:
                continue
            keys.append(kn)
    result_cols = []
    for ki in range(len(keys)):
        kn = keys[ki]
        is_bool = 1
        is_int = 1
        is_num = 1
        non_null = 0
        for oi in range(n_obj):
            o = root.items[oi]
            if o.kind != 1:
                continue
            val = _jt_obj_get(o, kn)
            if val.kind == 0 or val.kind == 6:
                continue  # thieu key hoac null tường minh -> khong anh huong dtype
            non_null = non_null + 1
            if val.kind == 5:
                is_int = 0
                is_num = 0
            elif val.kind == 3:
                is_bool = 0
                vs = val.s
                if vs.find(".") >= 0:
                    is_int = 0
            elif val.kind == 4:
                is_bool = 0
                is_int = 0
                is_num = 0
            else:
                is_bool = 0
                is_int = 0
                is_num = 0
        vm = make_mask(n_obj, 0)
        if non_null == 0:
            vals_s0 = []
            for oi in range(n_obj):
                vals_s0.append("")
            out = make_series_str(kn, vals_s0)
            result_cols.append(out)
            continue
        if is_bool == 1:
            vals_b = []
            for oi in range(n_obj):
                o = root.items[oi]
                val = _jt_obj_get(o, kn)
                if val.kind == 0 or val.kind != 5:
                    vals_b.append(0)
                    continue
                vals_b.append(val.b)
                vm.set(oi, 1)
            c2 = make_col_bool_with_mask(vals_b, vm)
            out = make_series(kn, c2)
        elif is_int == 1:
            vals_i = []
            for oi in range(n_obj):
                o = root.items[oi]
                val = _jt_obj_get(o, kn)
                if val.kind == 0 or val.kind != 3:
                    vals_i.append(0)
                    continue
                vals_i.append(int(val.f))
                vm.set(oi, 1)
            c2 = make_col_i64_with_mask(vals_i, vm)
            out = make_series(kn, c2)
        elif is_num == 1:
            vals_f = []
            for oi in range(n_obj):
                o = root.items[oi]
                val = _jt_obj_get(o, kn)
                if val.kind == 0 or val.kind != 3:
                    vals_f.append(0.0)
                    continue
                vals_f.append(val.f)
                vm.set(oi, 1)
            c2 = make_col_f64_with_mask(vals_f, vm)
            out = make_series(kn, c2)
        else:
            vals_s = []
            for oi in range(n_obj):
                o = root.items[oi]
                val = _jt_obj_get(o, kn)
                if val.kind == 0 or val.kind != 4:
                    vals_s.append("")
                    continue
                vals_s.append(val.s)
                vm.set(oi, 1)
            out = make_series_str_with_mask(kn, vals_s, vm)
        result_cols.append(out)
    return make_df(result_cols)


def json_read_file(file_path: "str") -> "DataFrame":
    return json_read_string(read_file(file_path))


def json_read_records(json_text: "str", num_cols: "list[str]", time_cols: "list[str]") -> "DataFrame":
    # read + ep kieu: num_cols -> f64, time_cols -> i64 epoch ms (dt_parse ISO);
    # cot khong nam trong 2 list: de json_read_string tu chuan hoa.
    df = json_read_string(json_text)
    for i in range(len(num_cols)):
        nm = num_cols[i]
        if df.has_col(nm) == 0:
            continue
        col = df.col_by_name(nm)
        vals_f2 = []
        vm = make_mask(df.row_count(), 0)
        for r in range(df.row_count()):
            if col.is_null(r) == 1:
                vals_f2.append(0.0)
                continue
            vals_f2.append(col.get_f64(r))
            vm.set(r, 1)
        nf = make_series_f64(nm, vals_f2)
        nf.valid = vm
        df = df.with_column(nm, nf)
    for i in range(len(time_cols)):
        nm = time_cols[i]
        if df.has_col(nm) == 0:
            continue
        col = df.col_by_name(nm)
        vals_i2 = []
        vm = make_mask(df.row_count(), 0)
        for r in range(df.row_count()):
            if col.is_null(r) == 1:
                vals_i2.append(0)
                continue
            vals_i2.append(dt_parse(col.get_string(r)))
            vm.set(r, 1)
        ni = make_series_i64(nm, vals_i2)
        ni.valid = vm
        df = df.with_column(nm, ni)
    return df


# === SECTION 3: write (orient=records) ========================================

def _jw_quote(s: "str") -> "str":
    out = "\""
    for i in range(len(s)):
        c = s[i]
        if c == "\"":
            out = out + "\\\""
        elif c == "\\":
            out = out + "\\\\"
        elif c == "\n":
            out = out + "\\n"
        elif c == "\t":
            out = out + "\\t"
        elif c == "\r":
            out = out + "\\r"
        else:
            out = out + c
    return out + "\""


def json_write_string(df: "DataFrame") -> "str":
    n = df.row_count()
    names = df.column_names()
    out = "["
    for r in range(n):
        if r > 0:
            out = out + ","
        out = out + "{"
        for c in range(len(names)):
            nm = names[c]
            col = df.col_by_name(nm)
            if c > 0:
                out = out + ","
            if col.is_null(r) == 1:
                out = out + _jw_quote(nm) + ":null"
            elif col.dtype == DT_STR:
                out = out + _jw_quote(nm) + ":" + _jw_quote(col.get_string(r))
            elif col.dtype == DT_I64:
                out = out + _jw_quote(nm) + ":" + str(col.get_i64(r))
            elif col.dtype == DT_BOOL:
                if col.get_bool(r) == 1:
                    out = out + _jw_quote(nm) + ":true"
                else:
                    out = out + _jw_quote(nm) + ":false"
            else:
                fv = col.get_f64(r)
                out = out + _jw_quote(nm) + ":" + str(fv)
        out = out + "}"
    return out + "]"


def json_write_file(df: "DataFrame", file_path: "str") -> "i32":
    write_file(file_path, json_write_string(df))
    return 0


# === SECTION 4: JSONL (moi dong 1 object) =====================================

def jsonl_read_string(text: "str") -> "DataFrame":
    # tach tung dong co '{' dau (bo space dau dong), noi bang ',' thanh array
    arr = "["
    i = 0
    n = len(text)
    first = 1
    while i < n:
        # bo space/trang
        while i < n:
            c = text[i]
            if c == " " or c == "\t" or c == "\n" or c == "\r":
                i = i + 1
            else:
                break
        if i >= n:
            break
        if text[i] != "{":
            # bo qua den cuoi dong
            while i < n and text[i] != "\n":
                i = i + 1
            continue
        j = i
        depth = 0
        instr = 0
        while j < n:
            cj = text[j]
            if instr == 1:
                if cj == "\\":
                    j = j + 2
                    continue
                if cj == "\"":
                    instr = 0
            else:
                if cj == "\"":
                    instr = 1
                elif cj == "{":
                    depth = depth + 1
                elif cj == "}":
                    depth = depth - 1
                    if depth == 0:
                        break
            j = j + 1
        if j >= n:
            break
        seg = text[i:j + 1]
        if first == 0:
            arr = arr + ","
        arr = arr + seg
        first = 0
        i = j + 1
    arr = arr + "]"
    if first == 1:
        return empty_df()
    return json_read_string(arr)


def jsonl_read_file(file_path: "str") -> "DataFrame":
    return jsonl_read_string(read_file(file_path))


# === SECTION 5: JSON object don (1 dong) ======================================

def json_read_object(json_text: "str") -> "DataFrame":
    root = _jt_parse(json_text, 0)
    if root.kind != 1:
        raise ValueError("json_read_object: root phai la JSON object")
    arr = "[" + json_text + "]"
    return json_read_string(arr)
