# ---- DataFrame utilities bo sung cho Relational/IO (clone + value get/set) ----


def df_schema_dtypes(df: "DataFrame") -> "list[i32]":
    dtypes_out = []
    n_sd = df.column_count()
    for i in range(n_sd):
        c = df.col_at(i)
        dtypes_out.append(c.dtype)
    return dtypes_out


def df_column_names(df: "DataFrame") -> "list[str]":
    names_out = []
    nc = df.column_count()
    for i in range(nc):
        c = df.col_at(i)
        names_out.append(c.name)
    return names_out


def df_clone(df: "DataFrame") -> "DataFrame":
    cols = []
    for i in range(len(df.cols)):
        c = df.cols[i]
        cols.append(c.clone_series())
    out = DataFrame()
    out.cols = cols
    return out

