            if av.bits[i] == 1 and bv.bits[i] == 1:
                r.i64s.append(ai[i] * bi[i])
                mk.set(i, 1)
            else:
                r.i64s.append(0)
        r.valid = mk
        return r
    af = a.f64s
    bf = b.f64s
    if av.all1() == 1 and bv.all1() == 1:
        rf = r.f64s
        for i in range(n):
            rf.append(af[i] * bf[i])
        mk = make_mask(n, 1)
        mk.pc = n
        r.valid = mk
        return r
    mk = make_mask(n, 0)
