AGG_MEDIAN = 10

JOIN_INNER = 1
JOIN_LEFT = 2
JOIN_RIGHT = 3
JOIN_FULL = 4
JOIN_CROSS = 5

ASOF_BACKWARD = 1
ASOF_FORWARD = 2
ASOF_NEAREST = 3


class AggExpr:
    target: "str"
    agg_type: "i32"
    output: "str"


# ---- DataFrame utilities bo sung cho Relational/IO (clone + value get/set) ----


def df_schema_dtypes(df: "DataFrame") -> "list[i32]":
    dtypes_out = []
    n_sd = df.column_count()
    for i in range(n_sd):
        c = df.col_at(i)
        dtypes_out.append(c.dtype)
    return dtypes_out


def df_column_names(df: "DataFrame") -> "list[str]":
    names_out = []
    nc = df.column_count()
    for i in range(nc):
        c = df.col_at(i)
        names_out.append(c.name)
    return names_out


def df_clone(df: "DataFrame") -> "DataFrame":
    cols = []
    for i in range(len(df.cols)):
        c = df.cols[i]
        cols.append(c.clone_series())
    out = DataFrame()
    out.cols = cols
    return out
