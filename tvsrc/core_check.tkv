# -*- coding: utf-8 -*-
__tkv_import__ = ["tokenvector_data", "tokenvector_compute"]

def run() -> "str":
    s1 = make_series("id", make_col_i64([1, 2, 3, 4]))
    s2 = make_series("score", make_col_f64([88.5, 92.0, 79.5, 95.0]))
    s3 = make_series_str("name", ["Alice", None, "Charlie", "David"])
    df = make_df([s1, s2, s3])
    print("shape: " + str(df.row_count()) + "x" + str(df.column_count()))
    got = df.col_by_name("NAME")
    print("by-name: " + got.name + " nulls=" + str(got.null_count()))
    sub = df.select(["name", "score"])
    sub_c0 = sub.col_at(0)
    print("select: " + str(sub.column_count()) + " cols, first=" + sub_c0.name)
    hp = df.head(2)
    hp_id = hp.col_by_name("id")
    print("head rows=" + str(hp.row_count()) + " v=" + str(hp_id.get_i64(1)))
    tp = df.tail(1)
    tp_sc = tp.col_by_name("score")
    print("tail v=" + str(tp_sc.get_f64(0)))
    dr = df.drop(["name"])
    print("drop: " + str(dr.column_count()))
    wc = df.with_column("half", make_series("half", make_col_f64([44.25, 46.0, 39.75, 47.5])))
    wc_h = wc.col_by_name("half")
    print("with-col: " + str(wc.column_count()) + " v=" + str(wc_h.get_f64(0)))
    rn = df.with_column_renamed("score", "diem")
    print("renamed has-diem=" + str(rn.has_col("diem")))
    m = make_mask(4, 1)
    m.set(2, 0)
    fl = df.filter(m)
    fl_nm = fl.col_by_name("name")
    print("filter rows=" + str(fl.row_count()) + " nulls_name=" + str(fl_nm.null_count()))
    desc = df.describe()
    print("describe rows=" + str(desc.row_count()) + " cols=" + str(desc.column_count()))
    desc_sc = desc.col_by_name("score")
    mean_row = desc_sc.get_f64(1)
    print("score mean=" + str(mean_row))
    dn = df.drop_null_rows([])
    print("drop-null rows=" + str(dn.row_count()))
    fn = df.fill_null_all(0.0, "X", [])
    fn_nm = fn.col_by_name("name")
    print("fill-null name0=" + fn_nm.get_string(0))
    ch = make_chunked_num([make_col_i64([1, 2]), make_col_i64([3, 4, 5])])
    print("chunked len=" + str(ch.length()) + " chunks=" + str(ch.chunk_count()))
    fm = ch.flatten_ca()
    print("flatten n=" + str(fm.length()) + " v4=" + str(fm.get_i64(4)))
    sorted_df = df.sort_by("score", 1)
    sd_sc = sorted_df.col_by_name("score")
    print("sorted first-score=" + str(sd_sc.get_f64(0)))
    return "SUCCESS"
