def vec_lt_scalar(a: "Col", s: "f64") -> "Mask":
    n = a.length()
    m = make_mask(n, 0)
    av = a.valid
    if a.dtype == DT_I64:
        ai = a.i64s
        si = int(s)
        if av.all1() == 1:
            bits = m.bits
            for i in range(n):
                if ai[i] < si:
                    bits[i] = 1
            return m
        for i in range(n):
            if av.bits[i] == 1:
                if ai[i] < si:
                    m.set(i, 1)
        return m
    af = a.f64s
    if av.all1() == 1:
        bits = m.bits
        for i in range(n):
            if af[i] < s:
                bits[i] = 1
        return m
    for i in range(n):
        if av.bits[i] == 1:
            if af[i] < s:
                m.set(i, 1)
    return m


def vec_le_scalar(a: "Col", s: "f64") -> "Mask":
    n = a.length()
    m = make_mask(n, 0)
    av = a.valid
    if a.dtype == DT_I64:
        ai = a.i64s
        si = int(s)
        if av.all1() == 1:
            bits = m.bits
            for i in range(n):
                if ai[i] <= si:
                    bits[i] = 1
            return m
        for i in range(n):
            if av.bits[i] == 1:
                if ai[i] <= si:
                    m.set(i, 1)
        return m
    af = a.f64s
    if av.all1() == 1:
        bits = m.bits
        for i in range(n):
            if af[i] <= s:
                bits[i] = 1
        return m
    for i in range(n):
        if av.bits[i] == 1:
            if af[i] <= s:
                m.set(i, 1)
    return m


def vec_eq_scalar(a: "Col", s: "f64") -> "Mask":
    n = a.length()
    m = make_mask(n, 0)
    av = a.valid
    if a.dtype == DT_I64:
        ai = a.i64s
        si = int(s)
        if av.all1() == 1:
            bits = m.bits
