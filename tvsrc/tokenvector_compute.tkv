    av = a.valid
    af = a.f64s
    if av.all1() == 1:
        rf = r.f64s
        for i in range(n):
            rf.append(af[i] ** 0.5)
        mk = make_mask(n, 1)
        mk.pc = n
        r.valid = mk
        return r
    mk = make_mask(n, 0)
    for i in range(n):
        if av.bits[i] == 1:
            r.f64s.append(af[i] ** 0.5)
            mk.set(i, 1)
        else:
            r.f64s.append(0.0)
    r.valid = mk
    return r


def vec_exp(a: "Col") -> "Col":
    n = a.length()
    r = make_col_f64([])
    r.dtype = DT_F64
    av = a.valid
    af = a.f64s
    if av.all1() == 1:
        rf = r.f64s
        for i in range(n):
            rf.append(_tkv_exp(af[i]))
        mk = make_mask(n, 1)
        mk.pc = n
        r.valid = mk
        return r
    mk = make_mask(n, 0)
    for i in range(n):
        if av.bits[i] == 1:
            r.f64s.append(_tkv_exp(af[i]))
            mk.set(i, 1)
        else:
            r.f64s.append(0.0)
    r.valid = mk
    return r


