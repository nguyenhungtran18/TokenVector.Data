# ------------------------------ VectorMath -----------------------------------
def vec_add(a: "Col", b: "Col") -> "Col":
    if a.length() != b.length():
        raise ValueError("Column lengths must match: " + str(a.length()) + " vs " + str(b.length()))
    n = a.length()
    r = make_col_f64([])
    r.dtype = a.dtype
    av = a.valid
    bv = b.valid
    if a.dtype == DT_I64:
        r.i64s = []
        ai = a.i64s
        bi = b.i64s
        if av.all1() == 1 and bv.all1() == 1:
            # Fast-path: khong co null -> bo is_null()/set() per-element
            ri = r.i64s
            for i in range(n):
                ri.append(ai[i] + bi[i])
            mk = make_mask(n, 1)
            mk.pc = n
            r.valid = mk
            return r
        mk = make_mask(n, 0)
        for i in range(n):
            if av.bits[i] == 1 and bv.bits[i] == 1:
                r.i64s.append(ai[i] + bi[i])
                mk.set(i, 1)
            else:
                r.i64s.append(0)
        r.valid = mk
        return r
    af = a.f64s
    bf = b.f64s
    if av.all1() == 1 and bv.all1() == 1:
        rf = r.f64s
        for i in range(n):
            rf.append(af[i] + bf[i])
        mk = make_mask(n, 1)
        mk.pc = n
        r.valid = mk
        return r
    mk = make_mask(n, 0)
    for i in range(n):
        if av.bits[i] == 1 and bv.bits[i] == 1:
            r.f64s.append(af[i] + bf[i])
            mk.set(i, 1)
        else:
            r.f64s.append(0.0)
    r.valid = mk
    return r


