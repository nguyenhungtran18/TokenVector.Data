                if ai[i] == si:
                    bits[i] = 1
            return m
        for i in range(n):
            if av.bits[i] == 1:
                if ai[i] == si:
                    m.set(i, 1)
        return m
    af = a.f64s
    if av.all1() == 1:
        bits = m.bits
        for i in range(n):
            if af[i] == s:
                bits[i] = 1
        return m
    for i in range(n):
        if av.bits[i] == 1:
