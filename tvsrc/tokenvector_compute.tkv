def vec_add_scalar(a: "Col", s: "f64") -> "Col":
    n = a.length()
    r = make_col_f64([])
    r.dtype = a.dtype
    av = a.valid
    if a.dtype == DT_I64:
        r.i64s = []
        ai = a.i64s
        si = int(s)
        if av.all1() == 1:
            ri = r.i64s
            for i in range(n):
                ri.append(ai[i] + si)
            mk = make_mask(n, 1)
            mk.pc = n
            r.valid = mk
            return r
        mk = make_mask(n, 0)
        for i in range(n):
            if av.bits[i] == 1:
                r.i64s.append(ai[i] + si)
                mk.set(i, 1)
            else:
                r.i64s.append(0)
        r.valid = mk
        return r
    af = a.f64s
    if av.all1() == 1:
        rf = r.f64s
        for i in range(n):
            rf.append(af[i] + s)
        mk = make_mask(n, 1)
        mk.pc = n
        r.valid = mk
        return r
    mk = make_mask(n, 0)
    for i in range(n):
        if av.bits[i] == 1:
            r.f64s.append(af[i] + s)
            mk.set(i, 1)
        else:
            r.f64s.append(0.0)
    r.valid = mk
    return r


