def vec_pow(a: "Col", exponent: "f64") -> "Col":
    n = a.length()
    r = make_col_f64([])
    r.dtype = DT_F64
    av = a.valid
    af = a.f64s
    if av.all1() == 1:
        rf = r.f64s
        for i in range(n):
            rf.append(af[i] ** exponent)
        mk = make_mask(n, 1)
        mk.pc = n
        r.valid = mk
        return r
    mk = make_mask(n, 0)
    for i in range(n):
        if av.bits[i] == 1:
            r.f64s.append(af[i] ** exponent)
            mk.set(i, 1)
        else:
            r.f64s.append(0.0)
    r.valid = mk
    return r


def _tkv_exp(x: "f64") -> "f64":
    # e^x qua chuoi Taylor voi Argument Reduction
    if x < 0.0:
        return 1.0 / _tkv_exp(-x)
    if x > 1.0:
        k = int(x / 0.6931471805599453) + 1
        r = _tkv_exp(x - k * 0.6931471805599453)
        e2 = 2.718281828459045
        for i in range(k):
            r = r * e2
        return r
    term = 1.0
    s = 1.0
    for i in range(1, 20):
        term = term * x / i
        s = s + term
    return s


def _tkv_ln(x: "f64") -> "f64":
    if x <= 0.0:
        raise ValueError("Log of non-positive value")
    e = 2.718281828459045
    k = 0
    while x >= 2.0:
        x = x / e
        k = k + 1
    while x < 0.5:
        x = x * e
        k = k - 1
    y = (x - 1.0) / (x + 1.0)
    y2 = y * y
    s = 0.0
    for i in range(30):
        s = s + (y ** (2 * i + 1)) / (2 * i + 1)
    return 2.0 * s + k



def vec_gt(a: "Col", b: "Col") -> "Mask":
    n = a.length()
    m = make_mask(n, 0)
    av = a.valid
    bv = b.valid
    if a.dtype == DT_I64:
        ai = a.i64s
        bi = b.i64s
        if av.all1() == 1 and bv.all1() == 1:
            bits = m.bits
            for i in range(n):
                if ai[i] > bi[i]:
                    bits[i] = 1
            return m
        for i in range(n):
            if av.bits[i] == 1 and bv.bits[i] == 1:
                if ai[i] > bi[i]:
                    m.set(i, 1)
        return m
    af = a.f64s
    bf = b.f64s
    if av.all1() == 1 and bv.all1() == 1:
        bits = m.bits
        for i in range(n):
            if af[i] > bf[i]:
                bits[i] = 1
        return m
    for i in range(n):
        if av.bits[i] == 1 and bv.bits[i] == 1:
            if af[i] > bf[i]:
                m.set(i, 1)
    return m


