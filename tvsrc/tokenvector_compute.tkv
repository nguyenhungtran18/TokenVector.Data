def vec_abs(a: "Col") -> "Col":
    n = a.length()
    r = make_col_f64([])
    r.dtype = a.dtype
    av = a.valid
    if a.dtype == DT_I64:
        r.i64s = []
        ai = a.i64s
        if av.all1() == 1:
            ri = r.i64s
            for i in range(n):
                vi = ai[i]
                if vi < 0:
                    vi = -1 * vi
                ri.append(vi)
            mk = make_mask(n, 1)
            mk.pc = n
            r.valid = mk
            return r
        mk = make_mask(n, 0)
        for i in range(n):
            if av.bits[i] == 1:
                vi = ai[i]
                if vi < 0:
                    vi = -1 * vi
                r.i64s.append(vi)
                mk.set(i, 1)
            else:
                r.i64s.append(0)
        r.valid = mk
        return r
    af = a.f64s
    if av.all1() == 1:
        rf = r.f64s
        for i in range(n):
            vf = af[i]
            if vf < 0.0:
                vf = -1.0 * vf
            rf.append(vf)
        mk = make_mask(n, 1)
        mk.pc = n
        r.valid = mk
        return r
    mk = make_mask(n, 0)
    for i in range(n):
        if av.bits[i] == 1:
            vf = af[i]
            if vf < 0.0:
                vf = -1.0 * vf
            r.f64s.append(vf)
            mk.set(i, 1)
        else:
            r.f64s.append(0.0)
    r.valid = mk
    return r


